[run]
source = automated_security_helper
omit =
    */tests/*
    */test_*
    automated_security_helper/identifiers/*

[report]
# Show missing lines in reports
show_missing = True
# No fail_under. The 80% threshold is passed as --fail-under 80 by the unit-coverage
# job in .github/workflows/ash-unified-ci.yml, to the combine step of the unit tier's
# coverage data (.github/scripts/combine-unit-coverage.py). Here it also gated every
# `pytest --cov` of a subset.

[html]
directory = test-results/coverage_html
title = ASH Coverage Report

[xml]
output = test-results/pytest.coverage.xml

[json]
output = test-results/pytest.coverage.json
pretty_print = True

[paths]
source = automated_security_helper/**/*.py
