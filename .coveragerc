[run]
source = automated_security_helper
omit =
    */tests/*
    */test_*
    automated_security_helper/identifiers/*

[report]
# Show missing lines in reports
show_missing = True
# No fail_under. The 80% threshold is passed as --fail-under 80 by the unit-coverage
# job in .github/workflows/ash-unified-ci.yml, once, to the combine of the coverage data
# of every unit leg (.github/scripts/combine-unit-coverage.py). Here it also gated every
# `pytest --cov` of a subset.

[html]
directory = test-results/coverage_html
title = ASH Coverage Report

[xml]
output = test-results/pytest.coverage.xml

[json]
output = test-results/pytest.coverage.json
pretty_print = True

# `coverage combine` folds the source paths each leg recorded into the first entry, which is
# the checkout the unit-coverage job combines in. A leg records absolute paths of its own
# runner (/home/runner/work/<repo>/<repo>/ on Linux, /Users/runner/work/... on macOS,
# D:\a\<repo>\<repo>\ on Windows). The macOS and Windows paths do not exist on the runner
# that combines, so a path that matches no alias makes `coverage report` fail with "No
# source for code" for that file. Slash in an alias matches either separator, so the
# second alias folds the Windows layout as well.
[paths]
source =
    automated_security_helper/
    */automated_security_helper/
