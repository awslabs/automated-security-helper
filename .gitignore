# Staged flat into assets/ by hatch_build.py because the shipped Dockerfile's
# build context is the assets directory and cannot COPY from outside it. The
# tracked originals are automated_security_helper/utils/tool_downloads.py and
# automated_security_helper/core/exceptions.py; these are copies, so committing
# them would create a second place a digest could be edited.
