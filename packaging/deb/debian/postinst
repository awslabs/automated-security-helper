#!/bin/sh
# Creates the venv and installs ASH's wheel into it.
#
# Deliberately NOT `set -e` at the top: a bare failure here leaves the package
# "installed" with a broken venv and no explanation. Each step is checked and
# reported instead, so the failure names what to do about it.
#
# @ASH_CLI@ is replaced by packaging/deb/build.sh with the name in
# packaging/cli-name.sh.
#
# The rpm's %post (packaging/rpm/ash.spec) does the same thing the same way. Change
# both together.
set -u

BASE=/usr/lib/ash
# A SYMLINK to the live venv, never a directory, except on a host upgrading from a
# release that predates this layout. See LAYOUT.
VENV="$BASE/venv"
WHEELS="$BASE/wheels"
CLI=@ASH_CLI@

# LAYOUT, AND WHY THE VENV IS SWAPPED BY RENAMING A SYMLINK
#
# Each install builds a fresh venv in its own directory, $BASE/venv-<id>, and only
# once that venv runs is $BASE/venv repointed at it, by renaming a new symlink over
# the old one. rename(2) replaces the link atomically, so at every instant
# /usr/lib/ash/venv resolves to a complete venv: the old one until the swap, the new
# one after it. An upgrade whose build fails (no index, a resolver conflict) never
# touches the link, so the previous install keeps working with nothing to restore.
#
# The venv directory itself is never renamed. A venv records its absolute path in
# every console script's shebang, so a venv built at one path and moved to another
# has scripts naming an interpreter that does not exist. Built at venv-<id> and
# reached through the link, every shebang stays correct for the venv's whole life.
#
# Earlier layouts, both measured as defects: deleting the venv and rebuilding it in
# place left /usr/bin/$CLI pointing at nothing for the whole rebuild, permanently if
# the rebuild failed; moving it aside and moving it back on failure fixed the
# permanent case but kept the window for the length of the pip install.
#
# A rebuild rather than `pip install --upgrade` into the old venv, because an
# in-place upgrade leaves the old distribution's entry points behind when a release
# renames one.
#
# Known limit: the previous venv is deleted right after the swap, so an `ash`
# process that was ALREADY running from it when the upgrade finished can fail on a
# later import. Every invocation started after the swap uses the new venv.
#
# prerm must leave the venv alone on `upgrade`, because it runs before this script.
# See packaging/deb/debian/prerm.

case "$1" in
  configure)
    # Exactly one wheel. dpkg has already replaced the old version's files when
    # configure runs, so two wheels here is a packaging accident, and picking either
    # would install a version nobody chose.
    wheel_count=0
    WHEEL=
    for candidate in "$WHEELS"/*.whl; do
      [ -f "$candidate" ] || continue
      wheel_count=$((wheel_count + 1))
      WHEEL="$candidate"
    done
    if [ "$wheel_count" -ne 1 ]; then
      echo "$CLI: expected exactly one wheel under $WHEELS, found $wheel_count." >&2
      echo "$CLI: the package is malformed." >&2
      exit 1
    fi

    NEW_NAME="venv-$(date +%s)-$$"
    NEW="$BASE/$NEW_NAME"
    SWAP="$BASE/venv.swap-$$"
    fail() {
      rm -rf "$NEW" "$SWAP"
      exit 1
    }

    if ! python3 -m venv "$NEW"; then
      echo "$CLI: failed to create a virtualenv at $NEW." >&2
      echo "$CLI: python3-venv is a declared dependency; if it is present, check" >&2
      echo "$CLI: that $BASE is writable and not on a noexec mount." >&2
      fail
    fi

    # The wheel is installed from the local path; its DEPENDENCIES come from whatever
    # Python index the host's pip configuration names. See README.Debian.
    if ! "$NEW/bin/pip" install --quiet --disable-pip-version-check "$WHEEL"; then
      echo "$CLI: failed to install $WHEEL into $NEW." >&2
      echo "$CLI: this step needs a reachable Python package index to resolve ASH's" >&2
      echo "$CLI: runtime dependencies. See /usr/share/doc/ash/README.Debian." >&2
      echo "$CLI: the previously installed version, if any, is untouched." >&2
      fail
    fi

    # Run the entry point rather than trusting pip's exit code. A wheel can install
    # cleanly and still not produce a working console script if its metadata is
    # wrong, and the wrapper in /usr/bin would then fail for every user.
    if ! "$NEW/bin/$CLI" --version >/dev/null 2>&1; then
      echo "$CLI: $WHEEL installed but $NEW/bin/$CLI does not run." >&2
      fail
    fi

    # A host upgrading from the directory layout has a real directory here, and a
    # symlink cannot be renamed over a non-empty directory. Moved aside once; this is
    # the one upgrade with a short window, and it is restored if the swap fails.
    MIGRATED=
    if [ -d "$VENV" ] && [ ! -L "$VENV" ]; then
      MIGRATED="$BASE/venv.previous"
      rm -rf "$MIGRATED"
      mv "$VENV" "$MIGRATED"
    fi

    if ! ln -s "$NEW_NAME" "$SWAP" || ! mv -T "$SWAP" "$VENV"; then
      echo "$CLI: could not point $VENV at $NEW." >&2
      if [ -n "$MIGRATED" ] && [ ! -e "$VENV" ]; then
        mv "$MIGRATED" "$VENV"
      fi
      fail
    fi

    # Every other venv is now unreachable: the one just replaced, a directory-layout
    # venv moved aside above, and anything a killed run left behind.
    for stale in "$BASE"/venv-* "$BASE"/venv.previous "$BASE"/venv.swap-*; do
      [ -e "$stale" ] || [ -L "$stale" ] || continue
      [ "$stale" = "$NEW" ] && continue
      rm -rf "$stale"
    done
    ;;
  abort-upgrade|abort-remove|abort-deconfigure)
    ;;
esac

exit 0
