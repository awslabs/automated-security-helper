# serializer version: 1
# name: test_message_variants
  dict({
    'grype-db / fail / stale': "Content database grype-db (grype) is stale: built <TIMESTAMP>, 8d 4h old, past its 120h bound (grype's own bound); age read from `built` in `grype db status -o json`, the database's own build time. The scan fails: a clean result from a stale database is not evidence of a clean target. To refresh it, run `grype db update` with network access, or rebuild the offline image (`ash build-image --offline`) so it downloads a current database. To scan against it anyway, pass --allow-stale-content-db or set `content_db_staleness: warn` in the ASH config.",
    'grype-db / fail / unreadable': "Content database grype-db (grype): the time it was built could not be read (ValueError: grype printed no build time), so it cannot be shown to be inside its 120h bound (grype's own bound). The scan fails: a clean result from a stale database is not evidence of a clean target. To refresh it, run `grype db update` with network access, or rebuild the offline image (`ash build-image --offline`) so it downloads a current database. To scan against it anyway, pass --allow-stale-content-db or set `content_db_staleness: warn` in the ASH config.",
    'grype-db / warn / stale': "Content database grype-db (grype) is stale: built <TIMESTAMP>, 8d 4h old, past its 120h bound (grype's own bound); age read from `built` in `grype db status -o json`, the database's own build time. The scan ran against it anyway because content_db_staleness is warn, so it may be missing advisories or rules published since. To refresh it, run `grype db update` with network access, or rebuild the offline image (`ash build-image --offline`) so it downloads a current database.",
    'grype-db / warn / unreadable': "Content database grype-db (grype): the time it was built could not be read (ValueError: grype printed no build time), so it cannot be shown to be inside its 120h bound (grype's own bound). The scan ran against it anyway because content_db_staleness is warn, so it may be missing advisories or rules published since. To refresh it, run `grype db update` with network access, or rebuild the offline image (`ash build-image --offline`) so it downloads a current database.",
    'opengrep-offline-rules / fail / stale': "Content database opengrep-offline-rules (opengrep) is stale: downloaded <TIMESTAMP>, 33d 4h old, past its 720h bound (ASH's bound); age read from the download time in `.ash-rules-fetched-at` in the cache directory, else the oldest rules file's mtime. The scan fails: a clean result from a stale database is not evidence of a clean target. To refresh it, rebuild the offline image (`ash build-image --offline`), which downloads the rulesets again, or download them into $OPENGREP_RULES_CACHE_DIR and record the time in .ash-rules-fetched-at. To scan against it anyway, pass --allow-stale-content-db or set `content_db_staleness: warn` in the ASH config.",
