# serializer version: 1
# name: test_already_inside_a_nix_shell
  dict({
    'ASH_IN_NIX': list([
    ]),
    'ASH_OFFLINE': list([
    ]),
    'exit_code': 1,
    'nix_commands': list([
    ]),
    'stderr': '''
      ASH is already running inside a Nix shell but was asked to enter one again. The inner invocation should carry --mode local; this is a bug, not a configuration problem.
  
    ''',
    'stdout': '',
  })
# ---
# name: test_nix_not_installed
  dict({
    'exit_code': 1,
    'stderr': '''
      --mode nix requires Nix, which was not found on PATH. Install it from https://nixos.org/download/ (Linux and macOS; on Windows use WSL2), or choose a different --mode. ASH will not fall back to --mode local here, because that would scan with whatever tools happen to be installed and report the absent ones as MISSING.
  
    ''',
    'stdout': '',
  })
# ---
# name: test_results_the_inner_run_did_not_mark_completed
  dict({
    'ASH_IN_NIX': list([
      '1',
    ]),
    'ASH_OFFLINE': list([
      'YES',
    ]),
    'exit_code': 1,
    'nix_commands': list([
      list([
        '/nix/var/nix/profiles/default/bin/nix',
        '--extra-experimental-features',
        'nix-command flakes',
        'develop',
        'path:<REPO>',
        '--command',
        '<PYTHON>',
        '<SAFE_PATH_FLAGS>',
        '-c',
        '''
          import sys; sys.path[:1] = [] if sys.path[:1] == [''] else sys.path[:1]
          exec(compile("import os, sys; outer = os.environ.pop('ASH_NIX_OUTER_PYTHONPATH', ''); sys.path[:0] = [os.path.abspath(d) for d in outer.split(os.pathsep)] if outer else []; sys.argv[0] = 'ash'; from automated_security_helper.cli.entrypoint import main; main()", '<ash>', 'exec'))
  
        ''',
        'scan',
        '--source-dir',
        '<TMP>/src',
        '--output-dir',
        '<TMP>/out',
        '--phases',
        'convert',
        '--phases',
        'scan',
        '--phases',
        'report',
        '--strategy',
        'parallel',
        '--no-progress',
        '--no-fail-on-incomplete-scanners',
        '--mode',
        'local',
        '--no-show-summary',
      ]),
    ]),
    'stderr': '',
    'stdout': '''
      INFO     Entering Nix shell from flake: path:<REPO>
      WARNING  Nix shell exited with code 2
      ERROR    The nix run did not complete, so its results are not read back: <TMP>/out/ash_aggregated_results.json holds no record that the run completed. The run's own output above says what stopped it. The inner run was started with this ASH's interpreter, <PYTHON>.
  
    ''',
  })
# ---
