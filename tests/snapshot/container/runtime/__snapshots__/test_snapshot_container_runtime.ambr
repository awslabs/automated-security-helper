# name: test_container_scan_of_the_fixture
  dict({
    'exit_code': 2,
    'host_output_after_container': '''
                   ERROR    Container execution failed with code 2
      
      === ASH Scan Completed in <DURATION>: Next Steps ===
      View detailed findings...
        - SARIF: 'out/reports/ash.sarif'
        - JUnit: 'out/reports/ash.junit.xml'
        - ASH aggregated results JSON available at: 'out/ash_aggregated_results.json'
      
      === Actionable findings detected! ===
      To investigate...
        1. Open one of the summary reports for a user-friendly table of the findings:
          - HTML report of all findings: 'out/reports/ash.html'
          - Markdown summary: 'out/reports/ash.summary.md'
          - Text summary: 'out/reports/ash.summary.txt'
        2. Use ash report to view a short text summary of the scan in your terminal
        3. Use ash inspect findings to explore the findings interactively
        4. Review scanner-specific reports and outputs in the 'out/scanners' directory
      
      === ASH Exit Codes ===
        0: success
        1: scan errors / scanner failures
        2: actionable findings at or above threshold (fail_on_findings is true; default true)
        3: invalid config or refused input
        4: workspace definition or policy error
        5: usage error
      ERROR (2) Exiting due to 1 actionable findings found in ASH scan
  
    ''',
  })
