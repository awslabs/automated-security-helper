  dict({
    'exit_code': 1,
    'stderr': '',
    'stdout': '''
      Refusing to merge: Shard indices [0] appear more than once. Merging a shard twice would double-count
      every finding it reported, because merging does not deduplicate.
  
    ''',
  })
# ---
