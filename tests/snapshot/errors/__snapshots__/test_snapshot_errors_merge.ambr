    ''',
  })
# ---
# name: test_refusal[candidate_assigned_to_no_shard]
  dict({
    'exit_code': 1,
    'stderr': '',
    'stdout': '''
      Refusing to merge: These scanners were candidates on every shard but assigned to none: grype. The
