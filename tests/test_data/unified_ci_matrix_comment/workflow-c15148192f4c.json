        },
        "timeout-minutes": 30
      },
      "integration-test-windows": {
        "name": "integration-test (${{ matrix.os }}, py${{ matrix.python-version }}, shard ${{ matrix.shard }})",
        "permissions": {
          "checks": "write",
          "contents": "read",
          "pull-requests": "write",
          "statuses": "write"
        },
        "runs-on": "${{ matrix.os }}",
        "strategy": {
          "fail-fast": false,
          "matrix": {
            "exclude": [
              {
                "python-version": "${{ github.event_name == 'pull_request' && '3.11' || '' }}"
              },
              {
                "python-version": "${{ github.event_name == 'pull_request' && '3.13' || '' }}"
              }
            ],
            "os": [
              "windows-latest"
            ],
            "python-version": [
              "3.11",
              "3.12",
              "3.13",
              "3.14"
            ],
            "shard": [
              "1of8",
              "2of8",
              "3of8",
              "4of8",
              "5of8",
              "6of8",
              "7of8",
              "8of8"
            ]
          },
          "max-parallel": 24
        },
        "timeout-minutes": 30
      },
      "lint": {
        "name": "lint",
        "runs-on": "ubuntu-24.04-arm",
        "timeout-minutes": 15
      },
      "multi-project-attribution": {
        "name": "multi-project attribution (${{ matrix.os }})",
        "permissions": {
          "contents": "read"
        },
        "runs-on": "${{ matrix.os }}",
        "strategy": {
          "fail-fast": false,
          "matrix": {
            "os": [
              "ubuntu-24.04-arm",
              "windows-latest"
            ]
          },
          "max-parallel": 2
        },
        "timeout-minutes": 30
      },
      "non-root-image-permissions": {
        "name": "non-root image permissions (ubuntu-latest)",
        "permissions": {
          "contents": "read"
        },
        "runs-on": "ubuntu-latest",
        "timeout-minutes": 45
      },
      "required-checks": {
        "if": "${{ always() && (cancelled() || contains(needs.*.result, 'failure') || contains(needs.*.result, 'cancelled')) }}",
        "name": "required-checks",
        "needs": [
          "lint",
          "ensure-cache",
          "actionlint",
          "snapshot-trailers",
          "unit-test-linux",
          "unit-test-macos",
          "unit-test-windows",
          "unit-coverage",
          "integration-test-linux",
          "integration-test-macos",
          "integration-test-windows",
          "e2e-test-linux",
          "e2e-test-macos",
          "e2e-test-windows",
          "scan-validation",
          "non-root-image-permissions",
          "external-target-scan",
          "multi-project-attribution",
          "deploy-aws-helpers",
          "integration-test",
          "docs-examples",
          "converter-integration",
          "build-docs",
          "install-validation",
          "homebrew-macos",
          "sandbox",
          "sandbox-scanner-parity"
        ],
        "runs-on": "ubuntu-24.04-arm",
        "timeout-minutes": 5
      },
      "sandbox": {
        "name": "sandbox escape (${{ matrix.os }})",
        "permissions": {
          "contents": "read"
        },
        "runs-on": "${{ matrix.os }}",
        "strategy": {
          "fail-fast": false,
          "matrix": {
            "include": [
              {
                "os": "ubuntu-latest",
                "require": "bwrap,firejail,landlock"
              },
              {
                "os": "macos-latest",
                "require": "sandbox-exec"
              }
            ]
          },
          "max-parallel": 2
        },
        "timeout-minutes": 20
      },
      "sandbox-scanner-parity": {
        "name": "sandbox scanner parity (${{ matrix.sandbox }}, ${{ matrix.os }})",
        "permissions": {
          "contents": "read"
        },
        "runs-on": "${{ matrix.os }}",
        "strategy": {
          "fail-fast": false,
          "matrix": {
            "include": [
              {
                "betterleaks": "true",
                "os": "ubuntu-latest",
                "sandbox": "bwrap"
              },
              {
                "betterleaks": "true",
                "os": "macos-latest",
                "sandbox": "sandbox-exec"
              }
            ]
          },
          "max-parallel": 2
        },
        "timeout-minutes": 45
      },
      "scan-validation": {
        "if": "${{ !cancelled() }}",
        "name": "scan (${{ matrix.method }}, ${{ matrix.os }})${{ matrix.oci-runner && matrix.oci-runner != 'docker' && format(' [{0}]', matrix.oci-runner) || '' }}${{ matrix.offline && ' [offline]' || '' }}${{ matrix.config-file == 'alpha' && ' - Alpha Plugins' || '' }}",
