            ]
          },
          "max-parallel": 20
        },
        "timeout-minutes": "${{ ((matrix.method == 'podman' || matrix.method == 'finch' || matrix.method == 'nerdctl') && 45) || (matrix.method == 'bundle' && 30) || 20 }}"
      },
      "integration-test": {
        "name": "integration-test (ubuntu-latest, shard ${{ matrix.shard }})",
        "permissions": {
          "contents": "read"
        },
        "runs-on": "ubuntu-latest",
        "strategy": {
          "fail-fast": false,
          "matrix": {
            "shard": [
              "1of4",
              "2of4",
              "3of4",
              "4of4"
            ]
          },
          "max-parallel": 4
        },
        "timeout-minutes": 30
      },
      "integration-test-linux": {
        "name": "integration-test (${{ matrix.os }}, py${{ matrix.python-version }}, shard ${{ matrix.shard }})",
        "permissions": {
          "checks": "write",
          "contents": "read",
          "pull-requests": "write",
          "statuses": "write"
        },
        "runs-on": "${{ matrix.os }}",
        "strategy": {
          "fail-fast": false,
          "matrix": {
            "exclude": [
              {
                "os": "${{ github.event_name == 'pull_request' && 'ubuntu-latest' || '' }}"
              },
              {
                "python-version": "${{ github.event_name == 'pull_request' && '3.11' || '' }}"
              },
              {
                "python-version": "${{ github.event_name == 'pull_request' && '3.13' || '' }}"
              }
            ],
            "os": [
              "ubuntu-latest",
              "ubuntu-24.04-arm"
            ],
            "python-version": [
              "3.11",
              "3.12",
              "3.13",
              "3.14"
            ],
            "shard": [
              "1of6",
              "2of6",
              "3of6",
              "4of6",
              "5of6",
              "6of6"
            ]
          },
          "max-parallel": 24
        },
        "timeout-minutes": 30
      },
      "integration-test-macos": {
        "name": "integration-test (${{ matrix.os }}, py${{ matrix.python-version }}, shard ${{ matrix.shard }})",
        "permissions": {
          "checks": "write",
          "contents": "read",
          "pull-requests": "write",
          "statuses": "write"
        },
        "runs-on": "${{ matrix.os }}",
        "strategy": {
          "fail-fast": false,
          "matrix": {
            "exclude": [
              {
