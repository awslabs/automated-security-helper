              },
              {
                "config-file": "default",
                "method": "sh-helper",
                "oci-runner": "podman",
                "os": "ubuntu-24.04-arm"
              },
              {
                "config-file": "default",
                "method": "python-local",
                "os": "macos-latest"
              },
              {
                "config-file": "default",
                "method": "python-local",
                "os": "windows-latest"
              },
              {
                "config-file": "default",
                "method": "python-container",
                "oci-runner": "docker",
                "offline": true,
                "os": "ubuntu-latest"
              },
              {
                "config-file": "alpha",
                "method": "python-local",
                "os": "ubuntu-latest"
              },
              {
                "config-file": "alpha",
                "method": "python-local",
                "os": "ubuntu-24.04-arm"
              },
              {
                "config-file": "alpha",
                "method": "python-local",
                "os": "macos-latest"
              },
              {
                "config-file": "alpha",
                "method": "python-local",
                "os": "windows-latest"
              }
            ]
          },
          "max-parallel": 29
        },
        "timeout-minutes": "${{ (matrix.oci-runner == 'podman' || matrix.oci-runner == 'finch') && 45 || 20 }}"
      },
      "snapshot-trailers": {
        "name": "snapshot-trailers",
        "runs-on": "ubuntu-24.04-arm",
        "timeout-minutes": 5
      },
      "unit-coverage": {
        "if": "${{ !cancelled() }}",
        "name": "unit-coverage",
        "needs": [
          "unit-test-linux",
          "unit-test-macos",
          "unit-test-windows"
        ],
        "permissions": {
          "contents": "read"
        },
        "runs-on": "ubuntu-24.04-arm",
        "timeout-minutes": 25
      },
      "unit-test-linux": {
        "name": "unit-test (${{ matrix.os }}, py${{ matrix.python-version }}, shard ${{ matrix.shard }})",
        "permissions": {
          "checks": "write",
          "contents": "read",
          "pull-requests": "write",
          "statuses": "write"
        },
        "runs-on": "${{ matrix.os }}",
        "strategy": {
          "fail-fast": false,
          "matrix": {
            "exclude": [
              {
                "os": "${{ github.event_name == 'pull_request' && 'ubuntu-latest' || '' }}"
              },
              {
                "python-version": "${{ github.event_name == 'pull_request' && '3.11' || '' }}"
              },
              {
                "python-version": "${{ github.event_name == 'pull_request' && '3.13' || '' }}"
              }
            ],
            "os": [
              "ubuntu-latest",
              "ubuntu-24.04-arm"
            ],
            "python-version": [
              "3.11",
              "3.12",
              "3.13",
              "3.14"
            ],
            "shard": [
              "1of6",
              "2of6",
              "3of6",
              "4of6",
              "5of6",
              "6of6"
            ]
          },
          "max-parallel": 24
        },
        "timeout-minutes": 45
      },
      "unit-test-macos": {
        "name": "unit-test (${{ matrix.os }}, py${{ matrix.python-version }}, shard ${{ matrix.shard }})",
        "permissions": {
          "checks": "write",
          "contents": "read",
          "pull-requests": "write",
          "statuses": "write"
        },
        "runs-on": "${{ matrix.os }}",
        "strategy": {
          "fail-fast": false,
          "matrix": {
            "exclude": [
              {
                "os": "${{ github.event_name == 'pull_request' && 'macos-latest' || '' }}"
              },
              {
                "python-version": "${{ github.event_name == 'pull_request' && '3.11' || '' }}"
              },
              {
                "python-version": "${{ github.event_name == 'pull_request' && '3.13' || '' }}"
              }
            ],
            "os": [
              "macos-latest",
              "macos-15"
            ],
            "python-version": [
              "3.11",
              "3.12",
              "3.13",
              "3.14"
            ],
            "shard": [
              "1of8",
              "2of8",
              "3of8",
              "4of8",
              "5of8",
              "6of8",
              "7of8",
              "8of8"
            ]
          },
          "max-parallel": 24
        },
        "timeout-minutes": 45
      },
      "unit-test-windows": {
        "name": "unit-test (${{ matrix.os }}, py${{ matrix.python-version }}, shard ${{ matrix.shard }})",
        "permissions": {
          "checks": "write",
          "contents": "read",
          "pull-requests": "write",
          "statuses": "write"
        },
        "runs-on": "${{ matrix.os }}",
        "strategy": {
          "fail-fast": false,
          "matrix": {
            "exclude": [
              {
                "python-version": "${{ github.event_name == 'pull_request' && '3.11' || '' }}"
              },
              {
                "python-version": "${{ github.event_name == 'pull_request' && '3.13' || '' }}"
              }
            ],
            "os": [
              "windows-latest"
            ],
            "python-version": [
              "3.11",
              "3.12",
              "3.13",
              "3.14"
            ],
            "shard": [
              "1of8",
              "2of8",
              "3of8",
              "4of8",
              "5of8",
              "6of8",
              "7of8",
              "8of8"
            ]
          },
          "max-parallel": 24
        },
        "timeout-minutes": 90
      },
      "warm-image-layers": {
        "concurrency": {
          "cancel-in-progress": false,
          "group": "ash-image-layer-cache-${{ matrix.os }}"
        },
        "if": "github.event_name == 'push' && github.ref == 'refs/heads/main'",
        "name": "warm image layers (${{ matrix.os }})",
        "permissions": {
          "contents": "read"
        },
        "runs-on": "${{ matrix.os }}",
        "strategy": {
          "fail-fast": false,
          "matrix": {
            "os": [
              "ubuntu-latest",
              "ubuntu-24.04-arm"
            ]
          },
          "max-parallel": 2
        },
        "timeout-minutes": 30
      }
    },
    "name": "ASH - Unified CI",
    "on": {
      "merge_group": {
        "types": [
          "checks_requested"
        ]
      },
      "pull_request": {
        "branches": [
          "**"
        ]
      },
      "push": {
        "branches": [
          "main"
        ]
      },
      "workflow_dispatch": {}
    },
    "permissions": {
      "contents": "read"
    }
  }
}
