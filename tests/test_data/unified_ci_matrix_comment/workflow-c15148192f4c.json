{
  "job_order": [
    "lint",
    "ensure-cache",
    "actionlint",
    "snapshot-trailers",
    "unit-test-linux",
    "unit-test-macos",
    "unit-test-windows",
    "unit-coverage",
    "integration-test-linux",
    "integration-test-macos",
    "integration-test-windows",
    "e2e-test-linux",
    "e2e-test-macos",
    "e2e-test-windows",
    "e2e-express",
    "warm-image-layers",
    "scan-validation",
    "non-root-image-permissions",
    "external-target-scan",
    "sandbox",
    "sandbox-scanner-parity",
    "multi-project-attribution",
    "deploy-aws-helpers",
    "integration-test",
    "docs-examples",
    "build-docs",
    "converter-integration",
    "install-validation",
    "homebrew-macos",
    "required-checks"
  ],
  "source": {
    "commit": "c15148192f4c70ca54c93b9333a281c0e054d727",
    "derived": "the workflow parsed with yaml.safe_load, every job's steps left out",
    "path": ".github/workflows/ash-unified-ci.yml"
  },
  "workflow": {
    "concurrency": {
      "cancel-in-progress": "${{ github.ref != 'refs/heads/main' && !startsWith(github.ref, 'refs/tags/') }}",
      "group": "${{ github.workflow }}-${{ github.ref }}-${{ github.event_name == 'push' && github.sha || '' }}"
    },
    "env": {
      "COLUMNS": 160
    },
    "jobs": {
      "actionlint": {
        "env": {
          "ACTIONLINT_SHA256": "325e971b6ba9bfa504672e29be93c24981eeb1c07576d730e9f7c8805afff0c6",
          "ACTIONLINT_VERSION": "1.7.12",
          "SHELLCHECK_SHA256": "12b331c1d2db6b9eb13cfca64306b1b157a86eb69db83023e261eaa7e7c14588",
          "SHELLCHECK_VERSION": "0.11.0"
        },
        "name": "actionlint",
        "permissions": {
          "contents": "read"
        },
        "runs-on": "ubuntu-24.04-arm",
        "timeout-minutes": 10
      },
      "build-docs": {
        "name": "build-docs",
        "permissions": {
          "contents": "read"
        },
        "runs-on": "ubuntu-24.04-arm",
        "timeout-minutes": 20
      },
      "converter-integration": {
        "name": "converter-integration (${{ matrix.os }})",
        "permissions": {
          "contents": "read"
        },
        "runs-on": "${{ matrix.os }}",
        "strategy": {
          "fail-fast": false,
          "matrix": {
            "os": [
              "macos-latest",
              "windows-latest"
            ]
          },
          "max-parallel": 2
        },
        "timeout-minutes": 20
      },
      "deploy-aws-helpers": {
        "name": "deploy-tree AWS helpers (moto server)",
        "permissions": {
          "contents": "read"
        },
        "runs-on": "ubuntu-24.04-arm",
        "timeout-minutes": 15
      },
      "docs-examples": {
        "name": "docs-examples",
        "permissions": {
          "contents": "read"
        },
        "runs-on": "ubuntu-latest",
        "timeout-minutes": 20
      },
      "e2e-express": {
        "env": {
          "ASH_E2E_EXPRESS": "1"
        },
        "name": "e2e-express (${{ matrix.os }})",
        "permissions": {
          "contents": "read"
        },
        "runs-on": "${{ matrix.os }}",
        "strategy": {
          "fail-fast": false,
          "matrix": {
            "os": [
              "ubuntu-24.04-arm",
              "macos-15"
            ]
          }
        },
        "timeout-minutes": 20
      },
      "e2e-test-linux": {
        "name": "e2e-test (${{ matrix.os }})",
        "permissions": {
          "checks": "write",
          "contents": "read",
          "pull-requests": "write",
          "statuses": "write"
        },
        "runs-on": "${{ matrix.os }}",
        "strategy": {
          "fail-fast": false,
          "matrix": {
            "exclude": [
              {
                "os": "${{ github.event_name == 'pull_request' && 'ubuntu-latest' || '' }}"
              }
            ],
            "os": [
              "ubuntu-latest",
              "ubuntu-24.04-arm"
            ]
          }
        },
        "timeout-minutes": 30
      },
      "e2e-test-macos": {
        "name": "e2e-test (${{ matrix.os }})",
        "permissions": {
          "checks": "write",
          "contents": "read",
          "pull-requests": "write",
          "statuses": "write"
        },
        "runs-on": "${{ matrix.os }}",
        "strategy": {
          "fail-fast": false,
          "matrix": {
            "exclude": [
              {
                "os": "${{ github.event_name == 'pull_request' && 'macos-latest' || '' }}"
              }
            ],
            "os": [
              "macos-latest",
              "macos-15"
            ]
          }
        },
        "timeout-minutes": 30
      },
      "e2e-test-windows": {
        "name": "e2e-test (${{ matrix.os }})",
        "permissions": {
          "checks": "write",
          "contents": "read",
          "pull-requests": "write",
          "statuses": "write"
        },
        "runs-on": "${{ matrix.os }}",
        "strategy": {
          "fail-fast": false,
          "matrix": {
            "os": [
              "windows-latest"
            ]
          }
        },
        "timeout-minutes": 30
      },
      "ensure-cache": {
        "name": "ensure-cache (${{ matrix.os }})",
        "permissions": {
          "contents": "read"
        },
        "runs-on": "${{ matrix.os }}",
        "strategy": {
          "fail-fast": false,
          "matrix": {
            "exclude": [
              {
                "os": "${{ github.event_name == 'pull_request' && 'ubuntu-latest' || '' }}"
              },
              {
                "os": "${{ github.event_name == 'pull_request' && 'ubuntu-24.04' || '' }}"
              },
              {
                "os": "${{ github.event_name == 'pull_request' && 'macos-latest' || '' }}"
              },
              {
                "os": "${{ github.event_name == 'pull_request' && 'macos-15' || '' }}"
              }
            ],
            "os": [
              "ubuntu-latest",
              "ubuntu-24.04",
              "ubuntu-24.04-arm",
              "macos-latest",
              "macos-15",
              "windows-latest"
            ]
          },
          "max-parallel": 6
        },
        "timeout-minutes": 15
      },
      "external-target-scan": {
        "name": "external-target scan (${{ matrix.os }})",
        "permissions": {
          "contents": "read"
        },
        "runs-on": "${{ matrix.os }}",
        "strategy": {
          "fail-fast": false,
          "matrix": {
            "os": [
              "ubuntu-24.04-arm",
              "windows-latest"
            ]
          },
          "max-parallel": 2
        },
        "timeout-minutes": 30
      },
      "homebrew-macos": {
        "name": "homebrew (macos-15, in-repo formula)",
        "permissions": {
          "contents": "read"
        },
        "runs-on": "macos-15",
        "timeout-minutes": 20
      },
      "install-validation": {
        "name": "${{ matrix.method }} (${{ matrix.os }}, py${{ matrix.python-version }})",
        "runs-on": "${{ (matrix.method == 'finch' && matrix.os == 'ubuntu-latest') && 'ubuntu-24.04' || matrix.os }}",
        "strategy": {
          "fail-fast": false,
          "matrix": {
            "exclude": [
              {
                "method": "bundle",
                "os": "${{ github.event_name == 'pull_request' && 'ubuntu-latest' || '' }}"
              },
              {
                "method": "homebrew",
                "os": "${{ github.event_name == 'pull_request' && 'ubuntu-latest' || '' }}"
              },
              {
                "os": "${{ github.event_name == 'pull_request' && 'macos-latest' || '' }}"
              },
              {
                "python-version": "${{ github.event_name == 'pull_request' && '3.11' || '' }}"
              },
              {
                "python-version": "${{ github.event_name == 'pull_request' && '3.13' || '' }}"
              },
              {
                "method": "homebrew",
                "os": "windows-latest"
              },
              {
