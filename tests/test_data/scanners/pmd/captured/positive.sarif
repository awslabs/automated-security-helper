{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "PMD",
          "version": "7.29.0",
          "informationUri": "https://docs.pmd-code.org/latest/",
          "rules": [
            {
              "id": "HardCodedCryptoKey",
              "shortDescription": {"text": "Do not use hard coded encryption keys"},
              "properties": {"ruleset": "Security", "priority": 3, "tags": ["Security"]},
              "defaultConfiguration": {"level": "warning"}
            },
            {
              "id": "InsecureCryptoIv",
              "shortDescription": {"text": "Do not use hard coded initialization vector in crypto operations"},
              "properties": {"ruleset": "Security", "priority": 3, "tags": ["Security"]},
              "defaultConfiguration": {"level": "warning"}
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "HardCodedCryptoKey",
          "ruleIndex": 0,
          "message": {"text": "Do not use hard coded encryption keys"},
          "level": "warning",
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {"uri": "file:///work/src/Crypto.java"},
                "region": {"startLine": 7, "startColumn": 48, "endLine": 7, "endColumn": 66}
              }
            }
          ]
        },
        {
          "ruleId": "InsecureCryptoIv",
          "ruleIndex": 1,
          "message": {"text": "Do not use hard coded initialization vector in crypto operations"},
          "level": "warning",
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {"uri": "file:///work/src/Crypto.java"},
                "region": {"startLine": 10, "startColumn": 50, "endLine": 10, "endColumn": 68}
              }
            }
          ]
        }
      ],
      "invocations": [
        {
          "executionSuccessful": true,
          "toolConfigurationNotifications": [],
          "toolExecutionNotifications": []
        }
      ]
    }
  ]
}
