:"Be wary of letting constructors throw exceptions.","arguments":["org.dom4j.xpath.DefaultXPath","new org.dom4j.xpath.DefaultXPath(String)"]},"level":"note","locations":[{"physicalLocation":{"artifactLocation":{"uri":"org/dom4j/xpath/DefaultXPath.java"},"region":{"startLine":59}},"logicalLocations":[{"name":"new DefaultXPath(String)","kind":"function","fullyQualifiedName":"new org.dom4j.xpath.DefaultXPath(String)"}]}]},{"ruleId":"CT_CONSTRUCTOR_THROW","ruleIndex":6,"message":{"id":"default","text":"Be wary of letting constructors throw exceptions.","arguments":["org.dom4j.xpath.XPathPattern","new org.dom4j.xpath.XPathPattern(String)"]},"level":"note","locations":[{"physicalLocation":{"artifactLocation":{"uri":"org/dom4j/xpath/XPathPattern.java"},"region":{"startLine":58}},"logicalLocations":[{"name":"new XPathPattern(String)","kind":"function","fullyQualifiedName":"new org.dom4j.xpath.XPathPattern(String)"}]}]},{"ruleId":"EI_EXPOSE_REP","ruleIndex":0,"message":{"id":"default","text":"May expose internal representation by returning reference to mutable object","arguments":["org.dom4j.xpp.ProxyXmlStartTag.getDocumentFactory()","ProxyXmlStartTag.factory"]},"level":"note","locations":[{"physicalLocation":{"artifactLocation":{"uri":"org/dom4j/xpp/ProxyXmlStartTag.java"},"region":{"startLine":262}},"logicalLocations":[{"name":"ProxyXmlStartTag.factory","kind":"member","fullyQualifiedName":"org.dom4j.xpp.ProxyXmlStartTag.factory"}]}]},{"ruleId":"EI_EXPOSE_REP","ruleIndex":0,"message":{"id":"default","text":"May expose internal representation by returning reference to mutable object","arguments":["org.dom4j.xpp.ProxyXmlStartTag.getElement()","ProxyXmlStartTag.element"]},"level":"note","locations":[{"physicalLocation":{"artifactLocation":{"uri":"org/dom4j/xpp/ProxyXmlStartTag.java"},"region":{"startLine":270}},"logicalLocations":[{"name":"ProxyXmlStartTag.element","kind":"member","fullyQualifiedName":"org.dom4j.xpp.ProxyXmlStartTag.element"}]}]},{"ruleId":"EI_EXPOSE_REP2","ruleIndex":1,"message":{"id":"default","text":"May expose internal representation by incorporating reference to mutable object","arguments":["new org.dom4j.xpp.ProxyXmlStartTag(Element)","ProxyXmlStartTag.element"]},"level":"note","locations":[{"physicalLocation":{"artifactLocation":{"uri":"org/dom4j/xpp/ProxyXmlStartTag.java"},"region":{"startLine":42}},"logicalLocations":[{"name":"element","kind":"variable","fullyQualifiedName":"new org.dom4j.xpp.ProxyXmlStartTag(Element)#element"}]}]},{"ruleId":"EI_EXPOSE_REP2","ruleIndex":1,"message":{"id":"default","text":"May expose internal representation by incorporating reference to mutable object","arguments":["org.dom4j.xpp.ProxyXmlStartTag.setDocumentFactory(DocumentFactory)","ProxyXmlStartTag.factory"]},"level":"note","locations":[{"physicalLocation":{"artifactLocation":{"uri":"org/dom4j/xpp/ProxyXmlStartTag.java"},"region":{"startLine":266}},"logicalLocations":[{"name":"documentFactory","kind":"variable","fullyQualifiedName":"org.dom4j.xpp.ProxyXmlStartTag.setDocumentFactory(DocumentFactory)#documentFactory"}]}]}],"originalUriBaseIds":{},"taxonomies":[{"name":"CWE","version":"4.10","minimumRequiredLocalizedDataSemanticVersion":"4.10","releaseDateUtc":"2023-01-31","guid":"b8c54a32-de19-51d2-9a08-f0abfbaa7310","informationUri":"https://cwe.mitre.org/data/published/cwe_v4.10.pdf/","downloadUri":"https://cwe.mitre.org/data/xml/cwec_v4.10.xml.zip","isComprehensive":true,"organization":"MITRE","language":"en","shortDescription":{"text":"The MITRE Common Weakness Enumeration"},"taxa":[{"id":"1066","guid":"ef3f429a-d302-5789-b09c-e9ec1192e212","shortDescription":{"text":"Missing Serialization Control Element"},"fullDescription":{"text":"The product contains a serializable data element that does not\n\t\t\t\t\thave an associated serialization method."},"defaultConfiguration":{"level":"none"}},{"id":"173","guid":"b67cd62f-1f93-50af-9598-185e46d4af43","shortDescription":{"text":"Improper Handling of Alternate Encoding"},"fullDescription":{"text":"The product does not properly handle when an input uses an alternate encoding that is valid for the control sphere to which the input is being sent."},"defaultConfiguration":{"level":"none"}},{"id":"22","guid":"19cf96fc-1234-5a3d-8e5d-21b225b7d3e8","shortDescription":{"text":"Improper Limitation of a Pathname to a Restricted Directory ('Path Traversal')"},"fullDescription":{"text":"The product uses external input to construct a pathname that is intended to identify a file or directory that is located underneath a restricted parent directory, but the product does not properly neutralize special elements within the pathname that can cause the pathname to resolve to a location that is outside of the restricted directory."},"defaultConfiguration":{"level":"error"}},{"id":"374","guid":"2275aa67-8872-5cf8-b261-4835437b1a69","shortDescription":{"text":"Passing Mutable Objects to an Untrusted Method"},"fullDescription":{"text":"The product sends non-cloned mutable data as an argument to a method or function."},"defaultConfiguration":{"level":"warning"}},{"id":"396","guid":"c24b1221-f911-5812-b507-c0674237225d","shortDescription":{"text":"Declaration of Catch for Generic Exception"},"fullDescription":{"text":"Catching overly broad exceptions promotes complex error handling code that is more likely to contain security vulnerabilities."},"defaultConfiguration":{"level":"none"}},{"id":"400","guid":"259f1f4f-be62-5d3a-9e6c-f5d036351b72","shortDescription":{"text":"Uncontrolled Resource Consumption"},"fullDescription":{"text":"The product does not properly control the allocation and maintenance of a limited resource, thereby enabling an actor to influence the amount of resources consumed, eventually leading to the exhaustion of available resources."},"defaultConfiguration":{"level":"error"}},{"id":"412","guid":"c5e73a27-a1e4-51c6-9384-9950a78145c4","shortDescription":{"text":"Unrestricted Externally Accessible Lock"},"fullDescription":{"text":"The product properly checks for the existence of a lock, but the lock can be externally controlled or influenced by an actor that is outside of the intended sphere of control."},"defaultConfiguration":{"level":"none"}},{"id":"478","guid":"ae4f28cb-90f5-5701-96dc-bba3038396f3","shortDescription":{"text":"Missing Default Case in Multiple Condition Expression"},"fullDescription":{"text":"The code does not have a default case in an expression with multiple conditions, such as a switch statement."},"defaultConfiguration":{"level":"none"}},{"id":"500","guid":"3daf832f-2148-5080-9f85-24d444a30bd0","shortDescription":{"text":"Public Static Field Not Marked Final"},"fullDescription":{"text":"An object contains a public static field that is not marked final, which might allow it to be modified in unexpected ways."},"defaultConfiguration":{"level":"error"}},{"id":"502","guid":"ff25cc2c-fffa-57bc-8f05-4b360dd88816","shortDescription":{"text":"Deserialization of Untrusted Data"},"fullDescription":{"text":"The product deserializes untrusted data without sufficiently verifying that the resulting data will be valid."},"defaultConfiguration":{"level":"warning"}},{"id":"543","guid":"182f1a78-9185-53c0-b354-f44101949b6f","shortDescription":{"text":"Use of Singleton Pattern Without Synchronization in a Multithreaded Context"},"fullDescription":{"text":"The product uses the singleton pattern when creating a resource within a multithreaded environment."},"defaultConfiguration":{"level":"none"}},{"id":"563","guid":"9a63821a-d035-5c3f-baa7-c6c0f6b6f67f","shortDescription":{"text":"Assignment to Variable without Use"},"fullDescription":{"text":"The variable's value is assigned but never used, making it a dead store."},"defaultConfiguration":{"level":"none"}},{"id":"595","guid":"08ab604b-e79e-5d94-9bc9-a10ec48774f1","shortDescription":{"text":"Comparison of Object References Instead of Object Contents"},"fullDescription":{"text":"The product compares object references instead of the contents of the objects themselves, preventing it from detecting equivalent objects."},"defaultConfiguration":{"level":"none"}},{"id":"607","guid":"06374683-cdd9-5ca7-8da0-1856c28efb9d","shortDescription":{"text":"Public Static Final Field References Mutable Object"},"fullDescription":{"text":"A public or protected static final field references a mutable object, which allows the object to be changed by malicious code, or accidentally from another package."},"defaultConfiguration":{"level":"none"}},{"id":"611","guid":"b7383f8c-a52b-52c9-b7d1-95a3c511d9da","shortDescription":{"text":"Improper Restriction of XML External Entity Reference"},"fullDescription":{"text":"The product processes an XML document that can contain XML entities with URIs that resolve to documents outside of the intended sphere of control, causing the product to embed incorrect documents into its output."},"defaultConfiguration":{"level":"none"}},{"id":"918","guid":"5bb88194-5222-563c-b8e6-b0b769ed3c9a","shortDescription":{"text":"Server-Side Request Forgery (SSRF)"},"fullDescription":{"text":"The web server receives a URL or similar request from an upstream component and retrieves the contents of this URL, but it does not sufficiently ensure that the request is being sent to the expected destination."},"defaultConfiguration":{"level":"none"}}]}]}]}
