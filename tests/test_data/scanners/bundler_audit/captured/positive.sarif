        {
          "ruleId": "insecure-source",
          "level": "warning",
          "message": {
            "text": "The Gemfile.lock fetches gems from git://github.com/example/insecure.git, which is not protected against tampering in transit. Use an https:// (or ssh) source."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "Gemfile.lock"
                },
                "region": {
                  "startLine": 8
                }
              }
            }
