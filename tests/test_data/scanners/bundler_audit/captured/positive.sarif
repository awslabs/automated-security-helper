{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "bundler-audit",
          "informationUri": "https://github.com/rubysec/bundler-audit",
          "rules": [
            {
              "id": "insecure-source",
              "name": "insecure-source",
              "shortDescription": {
                "text": "Gem source fetched over an insecure protocol"
              },
              "properties": {
                "tags": [
                  "sca",
                  "dependency",
                  "ruby",
                  "supply-chain"
                ]
              },
              "helpUri": "https://github.com/rubysec/bundler-audit#readme"
            },
