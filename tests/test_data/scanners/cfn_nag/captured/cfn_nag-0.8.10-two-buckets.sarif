              "id": "CFN_NAG_W58",
              "name": "LambdaFunctionCloudWatchLogsRule",
              "fullDescription": {
                "text": "Lambda functions require permission to write CloudWatch Logs"
              }
            },
            {
              "id": "CFN_NAG_W89",
