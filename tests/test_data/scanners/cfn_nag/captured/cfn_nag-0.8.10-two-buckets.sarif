{
  "version": "2.1.0",
  "$schema": "https://raw.githubusercontent.com/oasis-tcs/sarif-spec/master/Schemata/sarif-schema-2.1.0.json",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "cfn_nag",
          "informationUri": "https://github.com/stelligent/cfn_nag",
          "semanticVersion": "0.8.10",
          "rules": [
            {
              "id": "CFN_NAG_F74",
              "name": "AlexaASKSkillAuthenticationConfigurationClientSecretRule",
              "fullDescription": {
                "text": "Alexa ASK Skill AuthenticationConfiguration ClientSecret must not be a plaintext string or a Ref to a NoEcho Parameter with a Default value."
              }
            },
            {
              "id": "CFN_NAG_F75",
              "name": "AlexaASKSkillAuthenticationConfigurationRefreshTokenRule",
              "fullDescription": {
                "text": "Alexa ASK Skill AuthenticationConfiguration RefreshToken must not be a plaintext string or a Ref to a NoEcho Parameter with a Default value."
              }
            },
            {
              "id": "CFN_NAG_W53",
              "name": "AmazonMQBrokerEncryptionOptionsRule",
              "fullDescription": {
                "text": "AmazonMQ Broker should specify EncryptionOptions"
              }
            },
            {
              "id": "CFN_NAG_F52",
              "name": "AmazonMQBrokerUsersPasswordRule",
              "fullDescription": {
                "text": "AmazonMQ Broker Users Password must not be a plaintext string or a Ref to a Parameter with a Default value. Can be Ref to a NoEcho Parameter without a Default, or a dynamic reference to a secretsmanager value."
              }
            },
            {
              "id": "CFN_NAG_F77",
              "name": "AmazonSimpleDBDomainRule",
              "fullDescription": {
                "text": "SimpleDB Domain should not be a declared resource"
              }
            },
            {
              "id": "CFN_NAG_F41",
              "name": "AmplifyAppAccessTokenRule",
              "fullDescription": {
                "text": "Amplify App AccessToken must not be a plaintext string or a Ref to a Parameter with a Default value.  Can be Ref to a NoEcho Parameter without a Default, or a dynamic reference to a secretsmanager value."
              }
            },
            {
              "id": "CFN_NAG_F50",
              "name": "AmplifyAppBasicAuthConfigPasswordRule",
              "fullDescription": {
                "text": "Amplify App BasicAuthConfig Password must not be a plaintext string or a Ref to a Parameter with a Default value.  Can be Ref to a NoEcho Parameter without a Default, or a dynamic reference to a secretsmanager value."
              }
            },
            {
              "id": "CFN_NAG_F58",
              "name": "AmplifyAppOauthTokenRule",
              "fullDescription": {
                "text": "Amplify App OauthToken must not be a plaintext string or a Ref to a Parameter with a Default value.  Can be Ref to a NoEcho Parameter without a Default, or a dynamic reference to a secretsmanager value."
              }
            },
            {
              "id": "CFN_NAG_F60",
              "name": "AmplifyBranchBasicAuthConfigPasswordRule",
              "fullDescription": {
                "text": "Amplify Branch BasicAuthConfig Password must not be a plaintext string or a Ref to a Parameter with a Default value.  Can be Ref to a NoEcho Parameter without a Default, or a dynamic reference to a secretsmanager value."
              }
            },
            {
              "id": "CFN_NAG_W45",
              "name": "ApiGatewayAccessLoggingRule",
              "fullDescription": {
                "text": "ApiGateway Deployment resource should have AccessLogSetting property configured when creating an API Stage itself (through specifying the StageName and StageDescription properties)."
              }
            },
            {
              "id": "CFN_NAG_W87",
              "name": "ApiGatewayCacheEncryptedRule",
              "fullDescription": {
                "text": "ApiGateway Deployment should have cache data encryption enabled when caching is enabled in StageDescription properties"
              }
            },
            {
              "id": "CFN_NAG_W68",
              "name": "ApiGatewayDeploymentUsagePlanRule",
              "fullDescription": {
                "text": "AWS::ApiGateway::Deployment resources should be associated with an AWS::ApiGateway::UsagePlan. "
              }
            },
            {
              "id": "CFN_NAG_W59",
              "name": "ApiGatewayMethodAuthorizationTypeRule",
              "fullDescription": {
                "text": "AWS::ApiGateway::Method should not have AuthorizationType set to 'NONE' unless it is of HttpMethod: OPTIONS."
              }
            },
            {
              "id": "CFN_NAG_W62",
              "name": "ApiGatewaySecurityPolicyRule",
              "fullDescription": {
                "text": "ApiGateway SecurityPolicy should use TLS 1.2"
              }
            },
            {
              "id": "CFN_NAG_W69",
              "name": "ApiGatewayStageAccessLoggingRule",
              "fullDescription": {
                "text": "AWS::ApiGateway::Stage should have the AccessLogSetting property defined."
              }
            },
            {
              "id": "CFN_NAG_W64",
              "name": "ApiGatewayStageUsagePlanRule",
              "fullDescription": {
                "text": "AWS::ApiGateway::Stage resources should be associated with an AWS::ApiGateway::UsagePlan. "
              }
            },
            {
              "id": "CFN_NAG_W46",
              "name": "ApiGatewayV2AccessLoggingRule",
              "fullDescription": {
                "text": "ApiGateway V2 should have access logging configured"
              }
            },
            {
              "id": "CFN_NAG_F53",
              "name": "AppStreamDirectoryConfigServiceAccountCredentialsAccountPasswordRule",
              "fullDescription": {
                "text": "AppStream DirectoryConfig ServiceAccountCredentials AccountPassword must not be a plaintext string or a Ref to a Parameter with a Default value.  Can be Ref to a NoEcho Parameter without a Default, or a dynamic reference to a secretsmanager value."
              }
            },
            {
              "id": "CFN_NAG_W34",
              "name": "BatchJobDefinitionContainerPropertiesPrivilegedRule",
              "fullDescription": {
                "text": "Batch Job Definition Container Properties should not have Privileged set to true"
              }
            },
            {
              "id": "CFN_NAG_W1",
              "name": "CloudFormationAuthenticationRule",
              "fullDescription": {
                "text": "Specifying credentials in the template itself is probably not the safest thing"
              }
            },
            {
              "id": "CFN_NAG_W10",
              "name": "CloudFrontDistributionAccessLoggingRule",
              "fullDescription": {
                "text": "CloudFront Distribution should enable access logging"
              }
            },
            {
              "id": "CFN_NAG_W70",
              "name": "CloudfrontMinimumProtocolVersionRule",
              "fullDescription": {
                "text": "Cloudfront should use minimum protocol version TLS 1.2"
              }
            },
            {
              "id": "CFN_NAG_W32",
              "name": "CodeBuildEncryptionKeyRule",
              "fullDescription": {
                "text": "CodeBuild project should specify an EncryptionKey value"
              }
            },
            {
              "id": "CFN_NAG_F69",
              "name": "CodePipelineWebhookAuthenticationConfigurationSecretTokenRule",
              "fullDescription": {
                "text": "CodePipeline Webhook AuthenticationConfiguration SecretToken must not be a plaintext string or a Ref to a Parameter with a Default value.  Can be Ref to a NoEcho Parameter without a Default, or a dynamic reference to a secretsmanager value."
              }
            },
            {
              "id": "CFN_NAG_W57",
              "name": "CognitoIdentityPoolAllowUnauthenticatedIdentitiesRule",
              "fullDescription": {
                "text": "AWS::Cognito::IdentityPool AllowUnauthenticatedIdentities property should be false but CAN be true if proper restrictive IAM roles and permissions are established for unauthenticated users."
              }
            },
            {
              "id": "CFN_NAG_F78",
              "name": "CognitoUserPoolMfaConfigurationOnorOptionalRule",
              "fullDescription": {
                "text": "AWS Cognito UserPool should have MfaConfiguration set to 'ON' (MUST be wrapped in quotes) or at least 'OPTIONAL'"
              }
            },
            {
              "id": "CFN_NAG_W83",
              "name": "DAXClusterEncryptionRule",
              "fullDescription": {
                "text": "DynamoDB Accelerator (DAX) Cluster should have encryption enabled"
              }
            },
            {
              "id": "CFN_NAG_W81",
              "name": "DLMLifecyclePolicyCrossRegionCopyEncryptionRule",
              "fullDescription": {
                "text": "DLM LifecyclePolicy PolicyDetails Actions CrossRegionCopy EncryptionConfiguration should enable Encryption"
              }
            },
            {
              "id": "CFN_NAG_F55",
              "name": "DMSEndpointMongoDbSettingsPasswordRule",
              "fullDescription": {
                "text": "DMS Endpoint MongoDbSettings Password must not be a plaintext string or a Ref to a Parameter with a Default value.  Can be Ref to a NoEcho Parameter without a Default, or a dynamic reference to a secretsmanager value."
              }
            },
            {
              "id": "CFN_NAG_F37",
              "name": "DMSEndpointPasswordRule",
              "fullDescription": {
                "text": "DMS Endpoint password must not be a plaintext string or a Ref to a Parameter with a Default value.  Can be Ref to a NoEcho Parameter without a Default, or a dynamic reference to a secretsmanager value."
              }
            },
            {
              "id": "CFN_NAG_W91",
              "name": "DMSReplicationInstanceNotPublicRule",
              "fullDescription": {
                "text": "Database Migration Service replication instances are public, property PubliclyAccessible should be set to false"
              }
            },
            {
              "id": "CFN_NAG_F36",
              "name": "DirectoryServiceMicrosoftADPasswordRule",
              "fullDescription": {
                "text": "Directory Service Microsoft AD password must not be a plaintext string or a Ref to a Parameter with a Default value.  Can be Ref to a NoEcho Parameter without a Default, or a dynamic reference to a secretsmanager/ssm-secure value."
              }
            },
            {
              "id": "CFN_NAG_F31",
              "name": "DirectoryServiceSimpleADPasswordRule",
              "fullDescription": {
                "text": "DirectoryService SimpleAD password must not be a plaintext string or a Ref to a Parameter with a Default value.  Can be Ref to a NoEcho Parameter without a Default, or a dynamic reference to a secretsmanager/ssm-secure value."
              }
            },
            {
              "id": "CFN_NAG_F70",
              "name": "DocDBDBClusterMasterUserPasswordRule",
              "fullDescription": {
                "text": "DocDB DB Cluster master user password must not be a plaintext string or a Ref to a Parameter with a Default value.  Can be Ref to a NoEcho Parameter without a Default, or a dynamic reference to a secretsmanager value."
              }
            },
            {
              "id": "CFN_NAG_W78",
              "name": "DynamoDBBackupRule",
              "fullDescription": {
                "text": "DynamoDB table should have backup enabled, should be set using PointInTimeRecoveryEnabled"
              }
            },
            {
              "id": "CFN_NAG_W73",
              "name": "DynamoDBBillingModeRule",
              "fullDescription": {
                "text": "DynamoDB table should have billing mode set to either PAY_PER_REQUEST or PROVISIONED"
              }
            },
            {
              "id": "CFN_NAG_W74",
              "name": "DynamoDBEncryptionRule",
              "fullDescription": {
                "text": "DynamoDB table should have encryption enabled using a CMK stored in KMS"
              }
            },
            {
              "id": "CFN_NAG_F79",
              "name": "EC2NetworkAclEntryDuplicateRule",
              "fullDescription": {
                "text": "A NetworkACL's rule numbers cannot be repeated unless one is egress and one is ingress."
              }
            },
            {
              "id": "CFN_NAG_W71",
              "name": "EC2NetworkAclEntryIneffectiveDenyRule",
              "fullDescription": {
                "text": "NetworkACL Entry Deny rules should affect all CIDR ranges."
              }
            },
            {
              "id": "CFN_NAG_W72",
              "name": "EC2NetworkAclEntryOverlappingPortsRule",
              "fullDescription": {
                "text": "NetworkACL Entries are reusing or overlapping ports which may create ineffective rules."
              }
            },
            {
              "id": "CFN_NAG_W67",
              "name": "EC2NetworkAclEntryPortRangeRule",
              "fullDescription": {
                "text": "TCP/UDP protocol NetworkACL entries possibly should not allow all ports."
              }
            },
            {
              "id": "CFN_NAG_W66",
              "name": "EC2NetworkAclEntryProtocolRule",
              "fullDescription": {
                "text": "To avoid opening all ports for Allow rules, EC2 NetworkACL Entry Protocol should be either 6 (for TCP), 17 (for UDP), 1 (for ICMP), or 58 (for ICMPv6, which must include an IPv6 CIDR block, ICMP type, and code)."
              }
            },
            {
              "id": "CFN_NAG_W33",
              "name": "EC2SubnetMapPublicIpOnLaunchRule",
              "fullDescription": {
                "text": "EC2 Subnet should not have MapPublicIpOnLaunch set to true"
              }
            },
            {
              "id": "CFN_NAG_W79",
              "name": "ECRRepositoryScanOnPushRule",
              "fullDescription": {
                "text": "ECR Repository should have ScanOnPush enabled"
              }
            },
            {
              "id": "CFN_NAG_F32",
              "name": "EFSFileSystemEncryptedRule",
              "fullDescription": {
                "text": "EFS FileSystem should have encryption enabled"
              }
            },
            {
              "id": "CFN_NAG_W82",
              "name": "EKSClusterEncryptionRule",
              "fullDescription": {
                "text": "EKS Cluster EncryptionConfig Provider should specify KeyArn to enable Encryption."
              }
            },
            {
              "id": "CFN_NAG_F63",
              "name": "EMRClusterKerberosAttributesADDomainJoinPasswordRule",
              "fullDescription": {
                "text": "EMR Cluster KerberosAttributes AD Domain JoinPassword must not be a plaintext string or a Ref to a Parameter with a Default value.  Can be Ref to a NoEcho Parameter without a Default, or a dynamic reference to a secretsmanager value."
              }
            },
            {
              "id": "CFN_NAG_F64",
              "name": "EMRClusterKerberosAttributesCrossRealmTrustPrincipalPasswordRule",
