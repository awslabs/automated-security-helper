{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "retire.js",
          "informationUri": "https://retirejs.github.io/retire.js/",
          "rules": [
            {
              "id": "CVE-2011-4969",
              "name": "jquery",
              "shortDescription": {
                "text": "XSS with location.hash"
              },
              "helpUri": "http://research.insecurelabs.org/jquery/test/"
            },
            {
              "id": "CVE-2012-6708",
              "name": "jquery",
              "shortDescription": {
                "text": "Selector interpreted as HTML"
              },
              "helpUri": "http://bugs.jquery.com/ticket/11290"
            },
            {
              "id": "CVE-2020-7656",
              "name": "jquery",
              "shortDescription": {
                "text": "Versions of jQuery prior to 1.9.0 are vulnerable to Cross-Site Scripting (XSS). The load method fails to recognize and strip script tags containing whitespace in the closing tag (e.g. </script >), allowing enclosed script logic to execute and enabling attackers to run arbitrary JavaScript in a victim's browser."
              },
              "helpUri": "https://github.com/advisories/GHSA-q4m3-2j7h-f7xw"
            },
            {
              "id": "CVE-2015-9251",
              "name": "jquery",
              "shortDescription": {
                "text": "3rd party CORS request may execute"
              },
              "helpUri": "http://blog.jquery.com/2016/01/08/jquery-2-2-and-1-12-released/"
            },
            {
              "id": "RETIREJS-jquery-issue-162",
              "name": "jquery",
              "shortDescription": {
                "text": "jQuery 1.x and 2.x are End-of-Life and no longer receiving security updates"
              },
              "helpUri": "https://github.com/jquery/jquery.com/issues/162"
            },
            {
              "id": "CVE-2019-11358",
              "name": "jquery",
              "shortDescription": {
                "text": "jQuery before 3.4.0, as used in Drupal, Backdrop CMS, and other products, mishandles jQuery.extend(true, {}, ...) because of Object.prototype pollution"
              },
              "helpUri": "https://blog.jquery.com/2019/04/10/jquery-3-4-0-released/"
            },
            {
              "id": "CVE-2020-11023",
              "name": "jquery",
              "shortDescription": {
                "text": "passing HTML containing <option> elements from untrusted sources - even after sanitizing it - to one of jQuery's DOM manipulation methods (i.e. .html(), .append(), and others) may execute untrusted code."
              },
              "helpUri": "https://blog.jquery.com/2020/04/10/jquery-3-5-0-released/"
            }
          ],
          "semanticVersion": "6.1.1"
        }
      },
      "results": [
        {
          "ruleId": "CVE-2011-4969",
          "kind": "fail",
          "level": "warning",
          "message": {
            "text": "jquery 1.6.1 has a known vulnerability (fixed in 1.6.3): XSS with location.hash"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "static/jquery-1.6.1.min.js"
                },
                "region": {
                  "startLine": 1
                }
              }
            }
          ],
          "properties": {
            "issue_severity": "MEDIUM",
            "tags": [
              "sca",
              "vulnerable-javascript",
              "security",
              "CWE-79"
            ],
            "package_name": "jquery",
            "package_version": "1.6.1",
            "component": "jquery",
            "version": "1.6.1",
            "detection": "filename",
            "cwe": [
              "CWE-79"
            ],
