{
  "$schema": "http://json.schemastore.org/sarif-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "secretlint",
          "rules": [
            {
              "id": "@secretlint/secretlint-rule-preset-recommend > @secretlint/secretlint-rule-github",
              "shortDescription": {
                "text": "secretlint rule(@secretlint/secretlint-rule-preset-recommend > @secretlint/secretlint-rule-github) error"
              },
              "helpUri": "https://github.com/secretlint/secretlint/blob/HEAD/docs/rules/github.md#GITHUB_TOKEN"
            }
          ],
          "version": "1.0.0",
          "informationUri": "https://github.com/secretlint/secretlint"
        }
      },
      "results": [
        {
          "level": "error",
          "message": {
            "text": "found GitHub Token(*****************************): ****************************************"
          },
          "ruleId": "@secretlint/secretlint-rule-preset-recommend > @secretlint/secretlint-rule-github",
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "app.yml",
                  "index": 0
                },
                "region": {
                  "startLine": 1,
                  "startColumn": 8,
                  "endLine": 1,
                  "endColumn": 48
                }
              }
            }
          ],
          "ruleIndex": 0
        }
      ],
      "artifacts": [
        {
          "sourceLanguage": "YAML",
          "location": {
            "uri": "app.yml"
          }
        }
      ]
    }
  ]
}