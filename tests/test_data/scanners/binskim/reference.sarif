{
  "version": "2.1.0",
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "BinSkim",
          "rules": []
        }
      },
      "results": [
        {
          "ruleId": "BA2008",
          "kind": "fail",
          "level": "error",
          "message": {
            "text": "'app' is a native binary that does not enable the control flow guard mitigation."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "bin/app.exe"
                }
              }
            }
          ]
        },
        {
          "ruleId": "BA3010",
          "kind": "fail",
          "level": "warning",
          "message": {
            "text": "'tool' is a dynamically linked ELF binary that does not enable RELRO."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "bin/tool"
                }
              }
            }
          ]
        },
        {
          "ruleId": "BA3003",
          "kind": "fail",
          "level": "note",
          "message": {
            "text": "'tool' does not enable the stack protector."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "bin/tool"
                }
              }
            }
          ]
        }
      ]
    }
  ]
}
