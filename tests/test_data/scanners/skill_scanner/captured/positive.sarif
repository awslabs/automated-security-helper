{
  "$schema": "https://raw.githubusercontent.com/oasis-tcs/sarif-spec/master/Schemata/sarif-schema-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "skill-scanner",
          "version": "1.0.0",
          "informationUri": "https://github.com/cisco-ai-defense/skill-scanner",
          "rules": [
            {
              "id": "MANIFEST_MISSING_LICENSE",
              "name": "Manifest Missing License",
              "shortDescription": {
                "text": "Skill does not specify a license"
              },
              "fullDescription": {
                "text": "Skill manifest does not include a 'license' field. Specifying a license helps users understand usage terms."
              },
              "defaultConfiguration": {
                "level": "note"
              },
              "properties": {
                "category": "policy_violation",
                "severity": "INFO",
                "tags": [
                  "policy_violation",
                  "security"
                ]
              },
              "help": {
                "text": "Add 'license' field to SKILL.md frontmatter (e.g., MIT, Apache-2.0)",
                "markdown": "**Remediation**: Add 'license' field to SKILL.md frontmatter (e.g., MIT, Apache-2.0)"
              }
            },
            {
              "id": "YARA_prompt_injection_generic",
              "name": "Yara Prompt Injection Generic",
              "shortDescription": {
                "text": "PROMPT INJECTION detected by YARA"
              },
              "fullDescription": {
                "text": "Generic prompt injection patterns: Ignore all previous instructions"
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "category": "prompt_injection",
                "severity": "CRITICAL",
                "tags": [
                  "prompt_injection",
                  "security"
                ]
              },
              "help": {
                "text": "Review and remove prompt injection pattern",
                "markdown": "**Remediation**: Review and remove prompt injection pattern"
              }
            },
            {
              "id": "PROMPT_INJECTION_IGNORE_INSTRUCTIONS",
              "name": "Prompt Injection Ignore Instructions",
              "shortDescription": {
                "text": "Attempts to override previous system instructions"
              },
              "fullDescription": {
                "text": "Pattern detected: Ignore all previous instructions"
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "category": "prompt_injection",
                "severity": "HIGH",
                "tags": [
                  "prompt_injection",
                  "security"
                ]
              },
              "help": {
                "text": "Remove instructions that attempt to override system behavior",
                "markdown": "**Remediation**: Remove instructions that attempt to override system behavior"
              }
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "MANIFEST_MISSING_LICENSE",
          "level": "note",
          "message": {
            "text": "Skill manifest does not include a 'license' field. Specifying a license helps users understand usage terms."
          },
          "properties": {
            "category": "policy_violation",
            "severity": "INFO",
            "remediation": "Add 'license' field to SKILL.md frontmatter (e.g., MIT, Apache-2.0)"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "marker-skill/SKILL.md",
                  "uriBaseId": "%SRCROOT%"
                }
              }
            }
          ],
          "fingerprints": {
            "primaryLocationLineHash": "MANIFEST_MISSING_LICENSE_c5ae9be793"
          }
        },
        {
          "ruleId": "YARA_prompt_injection_generic",
          "level": "error",
          "message": {
            "text": "Generic prompt injection patterns: Ignore all previous instructions"
          },
          "properties": {
            "category": "prompt_injection",
            "severity": "CRITICAL",
            "remediation": "Review and remove prompt injection pattern",
            "aitech": "AITech-1.1",
            "aisubtech": "AISubtech-1.1.1",
            "framework_mappings": [
              "OWASP: LLM01:2026: Prompt Injection",
              "OWASP: ASI01: Agent Goal Hijack",
              "MITRE ATLAS: AML.T0051: LLM Prompt Injection",
              "MITRE ATLAS: AML.T0054: LLM Jailbreak",
              "MITRE ATLAS: AML.T0093: Prompt Infiltration via Public-Facing Application",
              "NIST AML: NISTAML.018: Prompt Injection"
            ],
            "aitech_mappings": [
