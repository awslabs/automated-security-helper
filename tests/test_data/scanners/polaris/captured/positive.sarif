{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "runs": [
    {
      "results": [
        {"kind": "fail", "level": "warning", "locations": [{"physicalLocation": {"artifactLocation": {"uri": "deploy.yaml"}, "region": {"startLine": 4}}}], "message": {"text": "Deployment/web: Only one replica is scheduled"}, "properties": {"issue_severity": "MEDIUM", "tags": ["kubernetes", "reliability"]}, "ruleId": "deploymentMissingReplicas"},
        {"kind": "fail", "level": "warning", "locations": [{"physicalLocation": {"artifactLocation": {"uri": "deploy.yaml"}, "region": {"startLine": 4}}}], "message": {"text": "Deployment/web: Label app.kubernetes.io/instance must match metadata.name"}, "properties": {"issue_severity": "MEDIUM", "tags": ["kubernetes", "reliability"]}, "ruleId": "metadataAndInstanceMismatched"},
        {"kind": "fail", "level": "warning", "locations": [{"physicalLocation": {"artifactLocation": {"uri": "deploy.yaml"}, "region": {"startLine": 4}}}], "message": {"text": "Deployment/web: Should have a PodDisruptionBudget"}, "properties": {"issue_severity": "MEDIUM", "tags": ["kubernetes", "reliability"]}, "ruleId": "missingPodDisruptionBudget"},
        {"kind": "fail", "level": "warning", "locations": [{"physicalLocation": {"artifactLocation": {"uri": "deploy.yaml"}, "region": {"startLine": 4}}}], "message": {"text": "Deployment/web: The ServiceAccount will be automounted"}, "properties": {"issue_severity": "MEDIUM", "tags": ["kubernetes", "security"]}, "ruleId": "automountServiceAccountToken"},
        {"kind": "fail", "level": "warning", "locations": [{"physicalLocation": {"artifactLocation": {"uri": "deploy.yaml"}, "region": {"startLine": 4}}}], "message": {"text": "Deployment/web: A NetworkPolicy should match pod labels and contain applied egress and ingress rules"}, "properties": {"issue_severity": "MEDIUM", "tags": ["kubernetes", "security"]}, "ruleId": "missingNetworkPolicy"},
        {"kind": "fail", "level": "warning", "locations": [{"physicalLocation": {"artifactLocation": {"uri": "deploy.yaml"}, "region": {"startLine": 4}}}], "message": {"text": "Deployment/web: Priority class should be set"}, "properties": {"issue_severity": "MEDIUM", "tags": ["kubernetes", "reliability"]}, "ruleId": "priorityClassNotSet"},
        {"kind": "fail", "level": "warning", "locations": [{"physicalLocation": {"artifactLocation": {"uri": "deploy.yaml"}, "region": {"startLine": 4}}}], "message": {"text": "Deployment/web: Pod should be configured with a valid topology spread constraint"}, "properties": {"issue_severity": "MEDIUM", "tags": ["kubernetes", "reliability"]}, "ruleId": "topologySpreadConstraint"},
        {"kind": "fail", "level": "warning", "locations": [{"physicalLocation": {"artifactLocation": {"uri": "deploy.yaml"}, "region": {"startLine": 4}}}], "message": {"text": "Deployment/web container nginx: CPU limits should be set"}, "properties": {"issue_severity": "MEDIUM", "tags": ["kubernetes", "efficiency"]}, "ruleId": "cpuLimitsMissing"},
        {"kind": "fail", "level": "warning", "locations": [{"physicalLocation": {"artifactLocation": {"uri": "deploy.yaml"}, "region": {"startLine": 4}}}], "message": {"text": "Deployment/web container nginx: CPU requests should be set"}, "properties": {"issue_severity": "MEDIUM", "tags": ["kubernetes", "efficiency"]}, "ruleId": "cpuRequestsMissing"},
        {"kind": "fail", "level": "warning", "locations": [{"physicalLocation": {"artifactLocation": {"uri": "deploy.yaml"}, "region": {"startLine": 4}}}], "message": {"text": "Deployment/web container nginx: Container should not have insecure capabilities"}, "properties": {"issue_severity": "MEDIUM", "tags": ["kubernetes", "security"]}, "ruleId": "insecureCapabilities"},
        {"kind": "fail", "level": "warning", "locations": [{"physicalLocation": {"artifactLocation": {"uri": "deploy.yaml"}, "region": {"startLine": 4}}}], "message": {"text": "Deployment/web container nginx: Use one of AppArmor, Seccomp, SELinux, or dropping Linux Capabilities to restrict containers using unwanted privileges"}, "properties": {"issue_severity": "MEDIUM", "tags": ["kubernetes", "security"]}, "ruleId": "linuxHardening"},
        {"kind": "fail", "level": "warning", "locations": [{"physicalLocation": {"artifactLocation": {"uri": "deploy.yaml"}, "region": {"startLine": 4}}}], "message": {"text": "Deployment/web container nginx: Liveness probe should be configured"}, "properties": {"issue_severity": "MEDIUM", "tags": ["kubernetes", "reliability"]}, "ruleId": "livenessProbeMissing"},
        {"kind": "fail", "level": "warning", "locations": [{"physicalLocation": {"artifactLocation": {"uri": "deploy.yaml"}, "region": {"startLine": 4}}}], "message": {"text": "Deployment/web container nginx: Memory limits should be set"}, "properties": {"issue_severity": "MEDIUM", "tags": ["kubernetes", "efficiency"]}, "ruleId": "memoryLimitsMissing"},
        {"kind": "fail", "level": "warning", "locations": [{"physicalLocation": {"artifactLocation": {"uri": "deploy.yaml"}, "region": {"startLine": 4}}}], "message": {"text": "Deployment/web container nginx: Memory requests should be set"}, "properties": {"issue_severity": "MEDIUM", "tags": ["kubernetes", "efficiency"]}, "ruleId": "memoryRequestsMissing"},
        {"kind": "fail", "level": "warning", "locations": [{"physicalLocation": {"artifactLocation": {"uri": "deploy.yaml"}, "region": {"startLine": 4}}}], "message": {"text": "Deployment/web container nginx: Filesystem should be read only"}, "properties": {"issue_severity": "MEDIUM", "tags": ["kubernetes", "security"]}, "ruleId": "notReadOnlyRootFilesystem"},
        {"kind": "fail", "level": "error", "locations": [{"physicalLocation": {"artifactLocation": {"uri": "deploy.yaml"}, "region": {"startLine": 4}}}], "message": {"text": "Deployment/web container nginx: Privilege escalation should not be allowed"}, "properties": {"issue_severity": "HIGH", "tags": ["kubernetes", "security"]}, "ruleId": "privilegeEscalationAllowed"},
        {"kind": "fail", "level": "warning", "locations": [{"physicalLocation": {"artifactLocation": {"uri": "deploy.yaml"}, "region": {"startLine": 4}}}], "message": {"text": "Deployment/web container nginx: Image pull policy should be \"Always\""}, "properties": {"issue_severity": "MEDIUM", "tags": ["kubernetes", "reliability"]}, "ruleId": "pullPolicyNotAlways"},
        {"kind": "fail", "level": "warning", "locations": [{"physicalLocation": {"artifactLocation": {"uri": "deploy.yaml"}, "region": {"startLine": 4}}}], "message": {"text": "Deployment/web container nginx: Readiness probe should be configured"}, "properties": {"issue_severity": "MEDIUM", "tags": ["kubernetes", "reliability"]}, "ruleId": "readinessProbeMissing"},
        {"kind": "fail", "level": "error", "locations": [{"physicalLocation": {"artifactLocation": {"uri": "deploy.yaml"}, "region": {"startLine": 4}}}], "message": {"text": "Deployment/web container nginx: Should not be running as privileged"}, "properties": {"issue_severity": "HIGH", "tags": ["kubernetes", "security"]}, "ruleId": "runAsPrivileged"},
        {"kind": "fail", "level": "error", "locations": [{"physicalLocation": {"artifactLocation": {"uri": "deploy.yaml"}, "region": {"startLine": 4}}}], "message": {"text": "Deployment/web container nginx: Should not be allowed to run as root"}, "properties": {"issue_severity": "HIGH", "tags": ["kubernetes", "security"]}, "ruleId": "runAsRootAllowed"},
        {"kind": "fail", "level": "error", "locations": [{"physicalLocation": {"artifactLocation": {"uri": "deploy.yaml"}, "region": {"startLine": 4}}}], "message": {"text": "Deployment/web container nginx: Image tag should be specified"}, "properties": {"issue_severity": "HIGH", "tags": ["kubernetes", "reliability"]}, "ruleId": "tagNotSpecified"}
      ],
      "tool": {
        "driver": {
          "informationUri": "https://github.com/FairwindsOps/polaris",
          "name": "Polaris",
          "rules": [
            {"id": "deploymentMissingReplicas", "name": "deploymentMissingReplicas", "properties": {"tags": ["kubernetes", "reliability"]}, "shortDescription": {"text": "Only one replica is scheduled"}},
            {"id": "metadataAndInstanceMismatched", "name": "metadataAndInstanceMismatched", "properties": {"tags": ["kubernetes", "reliability"]}, "shortDescription": {"text": "Label app.kubernetes.io/instance must match metadata.name"}},
            {"id": "missingPodDisruptionBudget", "name": "missingPodDisruptionBudget", "properties": {"tags": ["kubernetes", "reliability"]}, "shortDescription": {"text": "Should have a PodDisruptionBudget"}},
            {"id": "automountServiceAccountToken", "name": "automountServiceAccountToken", "properties": {"tags": ["kubernetes", "security"]}, "shortDescription": {"text": "The ServiceAccount will be automounted"}},
            {"id": "missingNetworkPolicy", "name": "missingNetworkPolicy", "properties": {"tags": ["kubernetes", "security"]}, "shortDescription": {"text": "A NetworkPolicy should match pod labels and contain applied egress and ingress rules"}},
            {"id": "priorityClassNotSet", "name": "priorityClassNotSet", "properties": {"tags": ["kubernetes", "reliability"]}, "shortDescription": {"text": "Priority class should be set"}},
            {"id": "topologySpreadConstraint", "name": "topologySpreadConstraint", "properties": {"tags": ["kubernetes", "reliability"]}, "shortDescription": {"text": "Pod should be configured with a valid topology spread constraint"}},
            {"id": "cpuLimitsMissing", "name": "cpuLimitsMissing", "properties": {"tags": ["kubernetes", "efficiency"]}, "shortDescription": {"text": "CPU limits should be set"}},
            {"id": "cpuRequestsMissing", "name": "cpuRequestsMissing", "properties": {"tags": ["kubernetes", "efficiency"]}, "shortDescription": {"text": "CPU requests should be set"}},
            {"id": "insecureCapabilities", "name": "insecureCapabilities", "properties": {"tags": ["kubernetes", "security"]}, "shortDescription": {"text": "Container should not have insecure capabilities"}},
            {"id": "linuxHardening", "name": "linuxHardening", "properties": {"tags": ["kubernetes", "security"]}, "shortDescription": {"text": "Use one of AppArmor, Seccomp, SELinux, or dropping Linux Capabilities to restrict containers using unwanted privileges"}},
            {"id": "livenessProbeMissing", "name": "livenessProbeMissing", "properties": {"tags": ["kubernetes", "reliability"]}, "shortDescription": {"text": "Liveness probe should be configured"}},
            {"id": "memoryLimitsMissing", "name": "memoryLimitsMissing", "properties": {"tags": ["kubernetes", "efficiency"]}, "shortDescription": {"text": "Memory limits should be set"}},
            {"id": "memoryRequestsMissing", "name": "memoryRequestsMissing", "properties": {"tags": ["kubernetes", "efficiency"]}, "shortDescription": {"text": "Memory requests should be set"}},
            {"id": "notReadOnlyRootFilesystem", "name": "notReadOnlyRootFilesystem", "properties": {"tags": ["kubernetes", "security"]}, "shortDescription": {"text": "Filesystem should be read only"}},
            {"id": "privilegeEscalationAllowed", "name": "privilegeEscalationAllowed", "properties": {"tags": ["kubernetes", "security"]}, "shortDescription": {"text": "Privilege escalation should not be allowed"}},
            {"id": "pullPolicyNotAlways", "name": "pullPolicyNotAlways", "properties": {"tags": ["kubernetes", "reliability"]}, "shortDescription": {"text": "Image pull policy should be \"Always\""}},
            {"id": "readinessProbeMissing", "name": "readinessProbeMissing", "properties": {"tags": ["kubernetes", "reliability"]}, "shortDescription": {"text": "Readiness probe should be configured"}},
            {"id": "runAsPrivileged", "name": "runAsPrivileged", "properties": {"tags": ["kubernetes", "security"]}, "shortDescription": {"text": "Should not be running as privileged"}},
            {"id": "runAsRootAllowed", "name": "runAsRootAllowed", "properties": {"tags": ["kubernetes", "security"]}, "shortDescription": {"text": "Should not be allowed to run as root"}},
            {"id": "tagNotSpecified", "name": "tagNotSpecified", "properties": {"tags": ["kubernetes", "reliability"]}, "shortDescription": {"text": "Image tag should be specified"}}
          ]
        }
      }
    }
  ],
  "version": "2.1.0"
}
