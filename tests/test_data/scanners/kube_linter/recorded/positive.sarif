{
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "kube-linter",
          "version": "v0.8.3",
          "informationUri": "https://github.com/stackrox/kube-linter"
        }
      },
      "results": [
        {
          "ruleId": "privileged-container",
          "message": {
            "text": "container \"app\" is privileged\nobject: default/app"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {"uri": "deploy/app.yaml"},
                "region": {"startLine": 1}
              }
            }
          ]
        },
        {
          "ruleId": "unset-cpu-requirements",
          "message": {
            "text": "container \"app\" has cpu request 0\nobject: default/app"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {"uri": "deploy/app.yaml"},
                "region": {"startLine": 1}
              }
            }
          ]
        }
      ]
    }
  ]
}
