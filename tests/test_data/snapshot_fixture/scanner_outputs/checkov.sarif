{
  "version": "2.1.0",
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "Checkov",
          "version": "3.2.469",
          "informationUri": "https://checkov.io",
          "rules": [
            {
              "id": "CKV_AWS_20",
              "name": "S3 Bucket has an ACL defined which allows public READ access.",
              "shortDescription": {"text": "S3 Bucket has an ACL defined which allows public READ access."},
              "helpUri": "https://docs.prismacloud.io/en/enterprise-edition/policy-reference/aws-policies/s3-policies/s3-1-acl-read-permissions-everyone"
            },
            {
              "id": "CKV_AWS_18",
              "name": "Ensure the S3 bucket has access logging enabled",
              "shortDescription": {"text": "Ensure the S3 bucket has access logging enabled"},
              "helpUri": "https://docs.prismacloud.io/en/enterprise-edition/policy-reference/aws-policies/s3-policies/s3-13-enable-logging"
            },
            {
              "id": "CKV_DOCKER_8",
              "name": "Ensure the last USER is not root",
              "shortDescription": {"text": "Ensure the last USER is not root"}
            },
            {
              "id": "CKV_DOCKER_2",
              "name": "Ensure that HEALTHCHECK instructions have been added to container images",
              "shortDescription": {"text": "Ensure that HEALTHCHECK instructions have been added to container images"}
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "CKV_AWS_20",
          "ruleIndex": 0,
          "level": "error",
          "message": {"text": "S3 Bucket has an ACL defined which allows public READ access."},
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {"uri": "infra/main.tf"},
                "region": {"startLine": 6, "endLine": 9}
              }
            }
          ],
          "properties": {"issue_severity": "HIGH"}
        },
        {
          "ruleId": "CKV_AWS_18",
          "ruleIndex": 1,
          "level": "warning",
          "message": {"text": "Ensure the S3 bucket has access logging enabled"},
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {"uri": "infra/main.tf"},
                "region": {"startLine": 2, "endLine": 4}
              }
            }
          ],
          "properties": {"issue_severity": "MEDIUM"}
        },
        {
          "ruleId": "CKV_DOCKER_8",
          "ruleIndex": 2,
          "level": "warning",
          "message": {"text": "Ensure the last USER is not root"},
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {"uri": "Dockerfile"},
                "region": {"startLine": 5, "endLine": 5}
              }
            }
          ],
          "properties": {"issue_severity": "MEDIUM"}
        },
        {
          "ruleId": "CKV_DOCKER_2",
          "ruleIndex": 3,
          "level": "note",
          "message": {"text": "Ensure that HEALTHCHECK instructions have been added to container images"},
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {"uri": "Dockerfile"},
                "region": {"startLine": 1, "endLine": 6}
              }
            }
          ],
          "properties": {"issue_severity": "LOW"}
        }
      ]
    }
  ]
}
