{
  "version": "2.1.0",
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "Grype",
          "version": "0.100.0",
          "informationUri": "https://github.com/anchore/grype",
          "rules": [
            {
              "id": "CVE-2018-18074-requests",
              "name": "PythonMatcherExactDirectMatch",
              "shortDescription": {"text": "CVE-2018-18074 critical vulnerability for requests package"},
              "helpUri": "https://github.com/advisories/GHSA-x84v-xcm2-53pg",
              "properties": {"security-severity": "9.8"}
            },
            {
              "id": "CVE-2023-32681-requests",
              "name": "PythonMatcherExactDirectMatch",
              "shortDescription": {"text": "CVE-2023-32681 medium vulnerability for requests package"},
              "helpUri": "https://github.com/advisories/GHSA-j8r2-6x86-q33q",
              "properties": {"security-severity": "6.1"}
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "CVE-2018-18074-requests",
          "ruleIndex": 0,
          "level": "error",
          "message": {"text": "A critical vulnerability in requests 2.19.1 (fixed in 2.20.0) was found at requirements.txt"},
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {"uri": "requirements.txt"},
                "region": {"startLine": 1, "endLine": 1}
              }
            }
          ]
        },
        {
          "ruleId": "CVE-2023-32681-requests",
          "ruleIndex": 1,
          "level": "warning",
          "message": {"text": "A medium vulnerability in requests 2.19.1 (fixed in 2.31.0) was found at requirements.txt"},
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {"uri": "requirements.txt"},
                "region": {"startLine": 1, "endLine": 1}
              }
            }
          ]
        }
      ]
    }
  ]
}
