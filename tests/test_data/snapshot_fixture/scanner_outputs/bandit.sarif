{
  "version": "2.1.0",
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "Bandit",
          "version": "1.8.6",
          "informationUri": "https://bandit.readthedocs.io/",
          "rules": [
            {
              "id": "B602",
              "name": "subprocess_popen_with_shell_equals_true",
              "shortDescription": {"text": "subprocess call with shell=True identified, security issue."},
              "helpUri": "https://bandit.readthedocs.io/en/latest/plugins/b602_subprocess_popen_with_shell_equals_true.html"
            },
            {
              "id": "B105",
              "name": "hardcoded_password_string",
              "shortDescription": {"text": "Possible hardcoded password."},
              "helpUri": "https://bandit.readthedocs.io/en/latest/plugins/b105_hardcoded_password_string.html"
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "B602",
          "ruleIndex": 0,
          "level": "error",
          "message": {"text": "subprocess call with shell=True identified, security issue."},
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {"uri": "app/app.py"},
                "region": {"startLine": 9, "endLine": 9, "snippet": {"text": "    return subprocess.run(f\"pg_dump orders --where id={customer_id}\", shell=True)"}}
              }
            }
          ],
          "properties": {"issue_severity": "HIGH", "issue_confidence": "HIGH"}
        },
        {
          "ruleId": "B105",
          "ruleIndex": 1,
          "level": "note",
          "message": {"text": "Possible hardcoded password: 'hunter2-not-a-real-secret'"},
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {"uri": "app/app.py"},
                "region": {"startLine": 5, "endLine": 5}
              }
            }
          ],
          "properties": {"issue_severity": "LOW", "issue_confidence": "MEDIUM"}
        }
      ]
    }
  ]
}
