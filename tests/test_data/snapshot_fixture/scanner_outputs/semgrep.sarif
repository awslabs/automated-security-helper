{
  "version": "2.1.0",
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "Semgrep OSS",
          "semanticVersion": "1.140.0",
          "rules": [
            {
              "id": "dockerfile.security.last-user-is-root.last-user-is-root",
              "name": "dockerfile.security.last-user-is-root.last-user-is-root",
              "shortDescription": {"text": "The last user in the container is 'root'."}
            },
            {
              "id": "python.lang.best-practice.unpinned-shell-command",
              "name": "python.lang.best-practice.unpinned-shell-command",
              "shortDescription": {"text": "Command string built with an f-string."}
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "dockerfile.security.last-user-is-root.last-user-is-root",
          "ruleIndex": 0,
          "level": "note",
          "message": {"text": "The last user in the container is 'root'. Switch back to an unprivileged user."},
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {"uri": "Dockerfile"},
                "region": {"startLine": 5, "endLine": 5}
              }
            }
          ],
          "properties": {"issue_severity": "LOW"}
        },
        {
          "ruleId": "python.lang.best-practice.unpinned-shell-command",
          "ruleIndex": 1,
          "level": "none",
          "message": {"text": "Command string built with an f-string; prefer an argument list."},
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {"uri": "app/app.py"},
                "region": {"startLine": 9, "endLine": 9}
              }
            }
          ],
          "properties": {"issue_severity": "INFO"}
        }
      ]
    }
  ]
}
