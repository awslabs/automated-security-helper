{
  "version": "2.1.0",
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "detect-secrets",
          "version": "1.5.0",
          "rules": [
            {
              "id": "SECRET-SECRET-KEYWORD",
              "name": "Secret Keyword",
              "shortDescription": {"text": "Secret Keyword"}
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "SECRET-SECRET-KEYWORD",
          "ruleIndex": 0,
          "level": "error",
          "message": {"text": "Secret of type Secret Keyword detected in file app/app.py at line 5"},
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {"uri": "app/app.py"},
                "region": {"startLine": 5, "endLine": 5}
              }
            }
          ],
          "properties": {"issue_severity": "HIGH"}
        }
      ]
    }
  ]
}
