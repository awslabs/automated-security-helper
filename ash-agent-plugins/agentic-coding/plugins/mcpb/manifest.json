{
  "author": {
    "name": "AWS Labs",
    "url": "https://github.com/awslabs/automated-security-helper"
  },
  "compatibility": {
    "platforms": [
      "darwin",
      "linux",
      "win32"
    ]
  },
  "description": "Run ASH (Automated Security Helper) security scans via MCP \u2014 Bandit, Opengrep, detect-secrets, Checkov, Grype, Syft, and more across Python, JS, IaC, and dependencies.",
  "homepage": "https://github.com/awslabs/automated-security-helper",
  "keywords": [
    "security-scan",
    "vulnerability-scan",
    "ash",
    "sast",
    "sca",
    "checkov",
    "bandit",
    "opengrep",
    "semgrep",
    "grype"
  ],
  "license": "Apache-2.0",
  "long_description": "Run ASH (Automated Security Helper) security scans directly in Claude\nDesktop. Bundles uvx-based ASH MCP server invocation; no separate\ninstall step required beyond having uvx on the user's PATH.\n",
  "manifest_version": "0.4",
  "name": "ash",
  "repository": {
    "type": "git",
    "url": "https://github.com/awslabs/automated-security-helper"
  },
  "server": {
    "entry_point": "uvx",
    "mcp_config": {
      "args": [
        "--from=git+https://github.com/awslabs/automated-security-helper@v4.0.0",
        "ashx",
        "mcp"
      ],
      "command": "uvx",
      "env": {
        "FASTMCP_LOG_LEVEL": "ERROR"
      }
    },
    "type": "binary"
  },
  "version": "4.0.0"
}
