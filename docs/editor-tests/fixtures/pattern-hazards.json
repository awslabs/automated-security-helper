          "text": "\uff10123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"
        },
        {
          "match": false,
          "note": "empty text",
          "text": ""
        }
      ],
      "source": "patterns"
    },
    {
      "pattern": "^\\${(\\w+)(:?)([^}\\r\\n]*)}",
      "samples": [
