        },
        {
          "match": false,
          "note": "a space",
          "text": "ab c"
        },
        {
          "match": false,
          "note": "a dot",
          "text": "ab.c"
        },
        {
          "match": false,
          "note": "a combining mark is not a word character",
          "text": "nae\u0301"
        }
      ],
      "source": "patterns"
    },
    {
      "pattern": "^[0-9a-fA-F]{64}$",
      "samples": [
        {
