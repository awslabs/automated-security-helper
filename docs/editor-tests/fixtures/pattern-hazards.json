{
  "about": "Samples that tell Python's re.search apart from a careless JavaScript translation of the same pattern. Each group names a pattern by its Python source and says where the data block holds its translation: in its patterns map, or at env.referencePattern. A sample is the text and whether Python's re.search finds the pattern in it. The translation must give the same answer for every sample. The hazards are the ones the schema's patterns meet: a word character beyond ASCII, a trailing newline that $ accepts in Python and not in JavaScript, a carriage return or a line separator that Python's dot accepts and JavaScript's dot does not, and a combining mark that is not a word character in either.",
  "groups": [
    {
      "pattern": "^(!ENV )?\\$\\{\\w+(:.*)?\\}$",
      "samples": [
        {
          "match": true,
          "note": "plain reference",
          "text": "${FOO}"
        },
        {
          "match": true,
          "note": "explicit tag",
          "text": "!ENV ${FOO}"
        },
        {
          "match": true,
          "note": "default value",
          "text": "${FOO:bar}"
        },
        {
          "match": true,
          "note": "empty default",
          "text": "${FOO:}"
        },
        {
          "match": true,
          "note": "colon inside the default",
          "text": "${FOO:a:b}"
        },
        {
          "match": true,
          "note": "closing brace inside the default",
          "text": "${FOO:bar}}"
        },
        {
          "match": true,
          "note": "underscore and digit",
          "text": "${_1}"
        },
        {
          "match": true,
          "note": "non-ASCII letters are word characters",
          "text": "${\u00c4\u00d6}"
        },
        {
          "match": true,
          "note": "a full-width digit is a word character",
          "text": "${\uff19}"
        },
        {
          "match": true,
          "note": "one trailing newline, as a block scalar leaves",
          "text": "${FOO}\n"
        },
        {
          "match": true,
          "note": "a carriage return inside the default: the dot accepts it",
          "text": "${FOO:a\rb}"
        },
        {
          "match": true,
          "note": "a line separator inside the default: the dot accepts it",
          "text": "${FOO:a\u2028b}"
        },
        {
          "match": false,
          "note": "a newline inside the default: the dot refuses it",
          "text": "${FOO:a\nb}"
        },
        {
          "match": false,
          "note": "two trailing newlines: only one is forgiven",
          "text": "${FOO}\n\n"
        },
        {
          "match": false,
          "note": "a trailing carriage return",
          "text": "${FOO}\r"
        },
        {
          "match": false,
          "note": "trailing space",
          "text": "${FOO} "
        },
        {
          "match": false,
          "note": "leading space",
          "text": " ${FOO}"
        },
        {
          "match": false,
          "note": "no closing brace",
          "text": "${FOO"
        },
        {
          "match": false,
          "note": "no braces",
          "text": "$FOO"
        },
        {
          "match": false,
          "note": "no name",
          "text": "${}"
        },
        {
          "match": false,
          "note": "a hyphen is not a word character",
          "text": "${FOO-BAR}"
        },
        {
          "match": false,
          "note": "a space is not a word character",
          "text": "${FOO BAR}"
        },
        {
          "match": false,
          "note": "the tag needs its space",
          "text": "!ENV${FOO}"
        },
        {
          "match": false,
          "note": "the tag is case sensitive",
          "text": "!env ${FOO}"
        },
        {
          "match": false,
          "note": "a second closing brace with no default",
          "text": "${FOO}}"
        },
        {
          "match": false,
          "note": "a combining mark is not a word character",
          "text": "${e\u0301}"
        },
        {
          "match": false,
          "note": "empty text",
          "text": ""
        }
      ],
      "source": "patterns"
    },
    {
      "pattern": "^[a-zA-Z][\\w-]+$",
