          "text": "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdeg"
        },
        {
          "match": false,
          "note": "two trailing newlines",
          "text": "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef\n\n"
        },
        {
          "match": false,
          "note": "a trailing carriage return",
          "text": "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef\r"
        },
        {
          "match": false,
