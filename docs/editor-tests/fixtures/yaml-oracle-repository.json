        "      line_start: 136",
        "      line_end: 136",
        "      reason: >-",
        "        False positive. The table entry maps the detect-secrets scanner to the secrets",
        "        tool category.",
        "    # === Test code and its support files: one entry per rule and file ===",
        "    # The tests build made-up credentials, fixed temporary paths, wildcard addresses and",
        "    # shell calls on purpose, to check that ASH hides, refuses or confines them. Each",
        "    # entry below names one rule and one file, never a directory: the policy in",
        "    # tests/unit/config/test_no_directory_glob_secret_suppressions.py is that a new file",
        "    # which trips a rule is reported, not excused by an entry written for another file.",
        "    # The reasons describe the pattern instead of quoting a line, because a quoted line",
        "    # would make this file trip the same rules. Sorted by rule, then path.",
        "    - rule_id: B102",
        "      path: tests/unit/characterization/test_harness_confinement.py",
        "      reason: \"Test code. exec of source text the test itself holds, in the test's own namespace.\"",
        "    - rule_id: B102",
        "      path: tests/unit/cli/test_scan_messages_tell_the_truth.py",
        "      reason: \"Test code. exec of source text the test itself holds, in the test's own namespace.\"",
        "    - rule_id: B103",
        "      path: tests/unit/cli/mcp/test_source_delivery_deletes_read_only_scratch.py",
        "      reason: \"Test code. The test sets file modes on files and directories it creates, to check how ASH reads, removes or refuses them.\"",
        "    - rule_id: B103",
        "      path: tests/unit/cli/mcp/test_source_delivery_scratch_that_resists_deletion.py",
        "      reason: \"Test code. The test sets file modes on files and directories it creates, to check how ASH reads, removes or refuses them.\"",
        "    - rule_id: B103",
        "      path: tests/unit/config/test_a_checkout_boundary_needs_a_git_shaped_marker.py",
        "      reason: \"Test code. The test sets file modes on files and directories it creates, to check how ASH reads, removes or refuses them.\"",
        "    - rule_id: B103",
        "      path: tests/unit/config/test_add_suppression.py",
        "      reason: \"Test code. The test sets file modes on files and directories it creates, to check how ASH reads, removes or refuses them.\""
      ],
