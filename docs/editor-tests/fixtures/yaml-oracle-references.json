        "c: '${HOME}'",
        "d: ${}",
        "e: ${HOME",
        "f: $HOME",
        "g: $ {HOME}"
      ],
      "value": {
        "a": "x${HOME}",
        "b": "${HOME}",
        "c": "${HOME}",
        "d": "${}",
        "e": "${HOME",
        "f": "$HOME",
        "g": "$ {HOME}"
      }
    },
    {
      "id": "reference-explicit-tag",
      "lines": [
        "a: !ENV ${HOME}",
        "b: !ENV \"${HOME:x}\"",
        "c: !ENV plain text",
        "d: !ENV 'single'",
        "e: !ENV",
        "f: !ENV \"\""
      ],
      "value": {
        "a": "!ENV ${HOME}",
        "b": "!ENV ${HOME:x}",
        "c": "!ENV plain text",
        "d": "!ENV single",
        "e": "!ENV ",
        "f": "!ENV "
      }
    },
    {
      "id": "reference-in-collections",
      "lines": [
        "list:",
        "  - ${A}",
        "  - !ENV ${B}",
        "  - \"${C}\"",
        "map:",
        "  ${KEY}: value",
        "  k: ${V:{}}",
        "flow: [\"${A}\", !ENV \"${B}\", x]"
      ],
      "value": {
        "flow": [
          "${A}",
          "!ENV ${B}",
          "x"
        ],
        "list": [
          "${A}",
          "!ENV ${B}",
          "${C}"
        ],
        "map": {
          "${KEY}": "value",
          "k": "${V:{}}"
        }
      }
    },
    {
      "id": "reference-unquoted-in-a-flow-collection-is-an-error",
