exports[`what the manifest and activation present package.json contributions and the text around them 1`] = `
{
  "activationEvents": [],
  "capabilities": {
    "untrustedWorkspaces": {
      "description": "A scan runs ASH over the workspace, and ASH reads the workspace's own .ash/.ash.yaml, which can load Python plugin modules and so run code the repository supplies. Trust the workspace to scan it.",
      "supported": false,
    },
  },
  "categories": [
    "Linters",
  ],
  "contributes": {
    "commands": [
      {
        "category": "ASH",
        "command": "ash.scanWorkspace",
        "title": "ASH: Scan workspace",
      },
      {
        "category": "ASH",
        "command": "ash.clearFindings",
        "title": "ASH: Clear findings",
      },
    ],
    "configuration": {
      "properties": {
        "ash.executablePath": {
          "default": "",
          "markdownDescription": "The ASH executable to run. Empty (the default) runs \`ashx\` from PATH, and runs \`ash\` instead when \`ashx\` is not installed, with a one-time notice. Any other value is run exactly as given, with no fallback. On Windows with MSYS2 or Git Bash on PATH, a bare \`ash\` can resolve to the Almquist shell instead of ASH; set this to \`automated-security-helper\`, which ASH installs as a permanent alias for exactly that case.

Machine-scoped: this names a program that gets executed, so a cloned repository cannot set it from its own \`.vscode/settings.json\`.",
          "scope": "machine",
          "type": "string",
        },
        "ash.extraArguments": {
          "default": [],
          "items": {
            "type": "string",
          },
          "markdownDescription": "Extra arguments appended to \`ashx scan\`, for example \`--scanners detect-secrets\` or \`--offline\`. \`--output-dir\` and \`--source-dir\` are refused, in either form: the extension sets both, and \`ash.outputDirectory\` chooses where the scan writes.",
          "type": "array",
        },
        "ash.outputDirectory": {
          "default": ".ash/ash_output",
          "markdownDescription": "Directory the scan writes to, relative to the workspace folder. ASH writes its SARIF report to \`reports/ash.sarif\` underneath it.

It must resolve, symlinks included, to a folder inside the workspace folder. ASH clears directories under it before each scan, so an absolute path, a \`..\` escape or a link out of the workspace is refused and nothing runs.",
          "type": "string",
        },
        "ash.scanTimeoutSeconds": {
          "default": 1800,
          "markdownDescription": "Seconds to wait for a scan before stopping it and every process it started. \`0\` waits indefinitely. A scan can also be stopped from its progress notification.",
          "minimum": 0,
          "type": "number",
        },
      },
      "title": "Automated Security Helper",
    },
  },
  "description": "Runs the ASH CLI over the open workspace and reports its SARIF findings as editor diagnostics. Ships no scanners and no copy of ASH.",
  "displayName": "Automated Security Helper",
  "engines": {
    "node": ">=22",
    "vscode": "^1.85.0",
  },
  "publisher": "awslabs",
}
`;
