exports[`the scan outcomes a user can see ashx answers and is not ASH 1`] = `
{
  "notifications": [
    {
      "message": "ASH: "ashx" answered, but it is not ASH: \`ashx --version\` printed "BusyBox v1.36.1 (ash)" instead of a string naming automated-security-helper. Another program with that name is ahead of ASH on PATH, most often the Almquist shell that BusyBox installs as "ash". Set ash.executablePath to "automated-security-helper", which ASH installs for this case, or to ASH's full path. Refusing to scan: a shell writes no report, and an empty report would look exactly like a clean scan.",
      "severity": "error",
    },
  ],
  "output": [
    ""ashx" answered, but it is not ASH: \`ashx --version\` printed "BusyBox v1.36.1 (ash)" instead of a string naming automated-security-helper. Another program with that name is ahead of ASH on PATH, most often the Almquist shell that BusyBox installs as "ash". Set ash.executablePath to "automated-security-helper", which ASH installs for this case, or to ASH's full path. Refusing to scan: a shell writes no report, and an empty report would look exactly like a clean scan.",
  ],
  "problems": {},
  "progress": [],
  "status": "wrong-executable",
}
`;

